@{
    ViewData["Title"] = "ICS SRE vCenter Dashboard";
}

@model DashboardSummaryViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ICS SRE vCenter Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root {
            --dark-bg: #0f172a;
            --darker-bg: #020617;
            --card-bg: #1e293b;
            --border-color: #334155;
            --text-primary: #f1f5f9;
            --text-secondary: #cbd5e1;
            --accent-blue: #3b82f6;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-primary);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        .header {
            background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);
            padding: 3rem 2rem;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 2rem;
        }

        .header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .header p {
            font-size: 1.1rem;
            color: #94a3b8;
        }

        .analytics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .metric-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 0.75rem;
            padding: 1.5rem;
            border-left: 4px solid var(--accent-blue);
        }

        .metric-card.powered-on {
            border-left-color: #10b981;
        }

        .metric-card.powered-off {
            border-left-color: #ef4444;
        }

        .metric-card.storage {
            border-left-color: #a855f7;
        }

        .metric-card.memory {
            border-left-color: #f97316;
        }

        .metric-label {
            font-size: 0.875rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        .metric-value {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .metric-detail {
            font-size: 0.875rem;
            color: #64748b;
        }

        .search-section {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 0.75rem;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .search-section h3 {
            font-size: 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .search-mode {
            margin-bottom: 2rem;
        }

        .search-mode label {
            font-weight: 600;
            margin-bottom: 0.75rem;
            display: block;
            color: var(--text-primary);
        }

        .search-input-group {
            display: flex;
            gap: 0.75rem;
        }

        .search-input-group input,
        .search-input-group textarea,
        .search-input-group select {
            background-color: #0f172a;
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 0.75rem;
            border-radius: 0.5rem;
            font-size: 0.95rem;
        }

        .search-input-group input:focus,
        .search-input-group textarea:focus,
        .search-input-group select:focus {
            background-color: #0f172a;
            border-color: var(--accent-blue);
            color: var(--text-primary);
            outline: none;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .btn-search {
            background-color: var(--accent-blue);
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .btn-search:hover {
            background-color: #2563eb;
        }

        .btn-clear {
            background-color: #64748b;
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-export {
            background-color: #10b981;
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            font-weight: 600;
            cursor: pointer;
        }

        .advanced-filtering {
            border-top: 1px solid var(--border-color);
            padding-top: 1.5rem;
            margin-top: 1.5rem;
        }

        .advanced-filtering h5 {
            font-size: 1rem;
            margin-bottom: 1rem;
            color: var(--text-primary);
        }

        .filter-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
        }

        .filter-group label {
            font-size: 0.875rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        .filter-group select,
        .filter-group input {
            background-color: #0f172a;
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 0.5rem;
            border-radius: 0.375rem;
            font-size: 0.875rem;
        }

        .results-container {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 0.75rem;
            padding: 2rem;
            margin-top: 2rem;
            display: none;
        }

        .results-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        .results-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
        }

        .results-table thead {
            background-color: #0f172a;
            border-bottom: 1px solid var(--border-color);
        }

        .results-table th {
            padding: 0.75rem;
            text-align: left;
            color: var(--text-secondary);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-size: 0.75rem;
        }

        .results-table td {
            padding: 0.75rem;
            border-bottom: 1px solid var(--border-color);
        }

        .results-table tbody tr:hover {
            background-color: #1e293b;
        }

        .power-on {
            color: #10b981;
            font-weight: 600;
        }

        .power-off {
            color: #ef4444;
            font-weight: 600;
        }

        .loading {
            display: none;
            text-align: center;
            padding: 2rem;
            color: var(--text-secondary);
        }

        .alert {
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
        }

        .alert-info {
            background-color: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: #93c5fd;
        }

        .alert-error {
            background-color: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #fca5a5;
        }

        .last-updated {
            font-size: 0.875rem;
            color: var(--text-secondary);
            margin-top: 1rem;
            text-align: center;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 1rem;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="container">
            <h1>ICS SRE vCenter Dashboard</h1>
            <p>VM Search & Resource Analytics</p>
        </div>
    </div>

    <div class="container">
        <!-- Analytics Cards -->
        <div class="analytics-grid">
            <div class="metric-card">
                <div class="metric-label">Total VMs</div>
                <div class="metric-value" id="totalVms">@Model.TotalVms.ToString("N0")</div>
                <div class="metric-detail">@Model.TotalVCenters Online</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">vCenters</div>
                <div class="metric-value" id="totalVCenters">@Model.TotalVCenters</div>
                <div class="metric-detail">Active Sites</div>
            </div>

            <div class="metric-card powered-on">
                <div class="metric-label">Powered On</div>
                <div class="metric-value" id="poweredOnVms">@Model.PoweredOnVms.ToString("N0")</div>
                <div class="metric-detail">@((Model.TotalVms > 0 ? (Model.PoweredOnVms * 100 / Model.TotalVms) : 0).ToString("F1"))% of total</div>
            </div>

            <div class="metric-card powered-off">
                <div class="metric-label">Powered Off</div>
                <div class="metric-value" id="poweredOffVms">@Model.PoweredOffVms.ToString("N0")</div>
                <div class="metric-detail">@((Model.PoweredOffVms * 100).ToString("F1")) TB used</div>
            </div>

            <div class="metric-card storage">
                <div class="metric-label">Storage Utilization</div>
                <div class="metric-value" id="storagePercent">@Model.StorageUtilizationPercent.ToString("F1")%</div>
                <div class="metric-detail">0.0 TB of 0.0 TB</div>
            </div>

            <div class="metric-card memory">
                <div class="metric-label">Memory Allocation</div>
                <div class="metric-value" id="memoryPercent">@Model.MemoryAllocationPercent.ToString("F1")%</div>
                <div class="metric-detail">0.0 GB of 0.0 GB</div>
            </div>
        </div>

        <!-- Search Section -->
        <div class="search-section">
            <h3><i class="bi bi-search"></i> Search Single VM</h3>

            <div class="search-mode">
                <label>Search by VM name (supports wildcards: edp*, *qa*, etc.)</label>
                <div class="search-input-group">
                    <input type="text" id="singleVmInput" class="form-control" placeholder="Search by VM name (supports wildcards: edp*, *qa*, etc.)">
                    <button class="btn-search" onclick="searchSingleVm()">Search</button>
                </div>
            </div>

            <div class="search-section">
                <h3><i class="bi bi-diagram-3"></i> Search by vCenter</h3>
                <div class="search-mode">
                    <label>Select vCenter or search</label>
                    <div class="search-input-group">
                        <input type="text" id="vCenterInput" class="form-control" placeholder="Search or select a vCenter...">
                        <button class="btn-search" onclick="searchVCenter()">Search</button>
                    </div>
                </div>
            </div>

            <div class="search-section">
                <h3><i class="bi bi-file-text"></i> Search Multiple VMs</h3>
                <div class="search-mode">
                    <label>Enter VM names/patterns (one per line, Examples: edp*, *qa*, prod-db-*1)</label>
                    <div class="search-input-group">
                        <textarea id="batchSearchInput" class="form-control" style="width: 100%; min-height: 100px;" placeholder="Enter VM names/patterns (one per line)"></textarea>
                    </div>
                    <div class="search-input-group" style="margin-top: 0.75rem;">
                        <button class="btn-search" onclick="searchMultipleVms()">Search</button>
                        <button class="btn-clear" onclick="clearBatchSearch()">Clear Filters</button>
                    </div>
                </div>
            </div>

            <!-- Advanced Filtering -->
            <div class="advanced-filtering">
                <h5>Advanced Filtering (Optional)</h5>
                <div class="filter-grid">
                    <div class="filter-group">
                        <label>Power State</label>
                        <select id="filterPowerState" onchange="applyAdvancedFilters()">
                            <option value="">All</option>
                            <option value="PoweredOn">Powered On</option>
                            <option value="PoweredOff">Powered Off</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Guest OS</label>
                        <select id="filterGuestOs" onchange="applyAdvancedFilters()">
                            <option value="">All OSes</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Memory (GB)</label>
                        <select id="filterMemory" onchange="applyAdvancedFilters()">
                            <option value="">All Sizes</option>
                            <option value="4-8">4-8 GB</option>
                            <option value="8-16">8-16 GB</option>
                            <option value="16-32">16-32 GB</option>
                            <option value="32+">32+ GB</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>CPU Cores</label>
                        <select id="filterCpu" onchange="applyAdvancedFilters()">
                            <option value="">All Counts</option>
                            <option value="1-2">1-2 Cores</option>
                            <option value="2-4">2-4 Cores</option>
                            <option value="4-8">4-8 Cores</option>
                            <option value="8+">8+ Cores</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Tools Status</label>
                        <select id="filterToolsStatus" onchange="applyAdvancedFilters()">
                            <option value="">All</option>
                            <option value="running">Running</option>
                            <option value="notRunning">Not Running</option>
                        </select>
                    </div>
                </div>
                <div style="margin-top: 1rem;">
                    <button class="btn-search" onclick="applyAdvancedFilters()">Apply Filters</button>
                    <button class="btn-clear" onclick="clearAdvancedFilters()">Clear Filters</button>
                </div>
            </div>
        </div>

        <!-- Results -->
        <div class="results-container" id="resultsContainer">
            <div class="results-header">
                <h4 id="resultTitle">Search Results</h4>
                <button class="btn-export" onclick="exportResults()">Export to CSV</button>
            </div>
            <div class="loading" id="loading">
                <p>Loading results...</p>
            </div>
            <div id="resultsContent"></div>
        </div>

        <div class="last-updated" id="lastUpdated"></div>
    </div>

    <script>
        let currentResults = [];
        let lastSearchType = '';
        let lastSearchQuery = '';

        // Search Single VM
        function searchSingleVm() {
            const query = document.getElementById('singleVmInput').value.trim();
            if (!query) {
                alert('Please enter a search term');
                return;
            }

            showLoading();
            fetch(`/api/search-single-vm?query=${encodeURIComponent(query)}`)
                .then(r => r.json())
                .then(data => {
                    currentResults = data.results;
                    lastSearchType = 'single';
                    lastSearchQuery = query;
                    displayResults(data.results, `Single VM Search: "${query}" (${data.count})`);
                })
                .catch(err => showError('Search failed: ' + err.message));
        }

        // Search by vCenter
        function searchVCenter() {
            const query = document.getElementById('vCenterInput').value.trim();
            if (!query) {
                alert('Please enter a vCenter');
                return;
            }

            showLoading();
            fetch(`/api/search-vcenter?query=${encodeURIComponent(query)}`)
                .then(r => r.json())
                .then(data => {
                    currentResults = data.results;
                    lastSearchType = 'vcenter';
                    lastSearchQuery = query;
                    displayResults(data.results, `vCenter Search: "${query}" (${data.count})`);
                })
                .catch(err => showError('Search failed: ' + err.message));
        }

        // Search Multiple VMs
        function searchMultipleVms() {
            const query = document.getElementById('batchSearchInput').value.trim();
            if (!query) {
                alert('Please enter search patterns');
                return;
            }

            showLoading();
            fetch(`/api/search-multiple-vms?query=${encodeURIComponent(query)}`)
                .then(r => r.json())
                .then(data => {
                    currentResults = data.results;
                    lastSearchType = 'multiple';
                    lastSearchQuery = query;
                    displayResults(data.results, `Multiple VM Search (${data.count})`);
                })
                .catch(err => showError('Search failed: ' + err.message));
        }

        // Advanced Filters
        function applyAdvancedFilters() {
            const request = {
                vCenter: document.getElementById('vCenterInput').value || null,
                powerState: document.getElementById('filterPowerState').value || null,
                guestOs: document.getElementById('filterGuestOs').value || null,
                toolsStatus: document.getElementById('filterToolsStatus').value || null,
                memoryMin: parseMemoryRange('min'),
                memoryMax: parseMemoryRange('max'),
                cpuMin: parseCpuRange('min'),
                cpuMax: parseCpuRange('max')
            };

            showLoading();
            fetch('/api/advanced-filter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(request)
            })
                .then(r => r.json())
                .then(data => {
                    currentResults = data.results;
                    displayResults(data.results, `Advanced Filter Results (${data.count})`);
                })
                .catch(err => showError('Filter failed: ' + err.message));
        }

        function parseMemoryRange(type) {
            const val = document.getElementById('filterMemory').value;
            if (!val) return null;
            if (val === '4-8') return type === 'min' ? 4 : 8;
            if (val === '8-16') return type === 'min' ? 8 : 16;
            if (val === '16-32') return type === 'min' ? 16 : 32;
            if (val === '32+') return type === 'min' ? 32 : 999;
            return null;
        }

        function parseCpuRange(type) {
            const val = document.getElementById('filterCpu').value;
            if (!val) return null;
            if (val === '1-2') return type === 'min' ? 1 : 2;
            if (val === '2-4') return type === 'min' ? 2 : 4;
            if (val === '4-8') return type === 'min' ? 4 : 8;
            if (val === '8+') return type === 'min' ? 8 : 999;
            return null;
        }

        // Display Results Table
        function displayResults(results, title) {
            const container = document.getElementById('resultsContainer');
            const content = document.getElementById('resultsContent');

            if (results.length === 0) {
                content.innerHTML = '<p class="alert alert-info">No results found</p>';
            } else {
                let html = '<div class="table-responsive"><table class="results-table"><thead><tr>';
                html += '<th>VM Name</th><th>Power State</th><th>Hostname</th><th>vCenter</th><th>CPU</th><th>Memory GB</th>';
                html += '<th>Provisioned GB</th><th>Used GB</th><th>ESXi Host</th><th>Cluster</th><th>IP Address</th><th>Tools Status</th></tr></thead><tbody>';

                results.forEach(vm => {
                    const powerClass = (vm.powerState === 'PoweredOn') ? 'power-on' : 'power-off';
                    html += `<tr>
                        <td>${escapeHtml(vm.vmName)}</td>
                        <td><span class="${powerClass}">${vm.powerState}</span></td>
                        <td>${escapeHtml(vm.guestHostname) || '-'}</td>
                        <td>${escapeHtml(vm.vCenter) || '-'}</td>
                        <td>${vm.numCpu || '-'}</td>
                        <td>${vm.memoryGb ? vm.memoryGb.toFixed(2) : '-'}</td>
                        <td>${vm.provisionedGb ? vm.provisionedGb.toFixed(2) : '-'}</td>
                        <td>${vm.usedGb ? vm.usedGb.toFixed(2) : '-'}</td>
                        <td>${escapeHtml(vm.esxiHost) || '-'}</td>
                        <td>${escapeHtml(vm.cluster) || '-'}</td>
                        <td>${escapeHtml(vm.ipAddress) || '-'}</td>
                        <td>${escapeHtml(vm.toolsRunningStatus || vm.toolsStatus) || '-'}</td>
                    </tr>`;
                });

                html += '</tbody></table></div>';
                content.innerHTML = html;
            }

            document.getElementById('resultTitle').textContent = title;
            container.style.display = 'block';
            hideLoading();
        }

        function exportResults() {
            if (currentResults.length === 0) {
                alert('No results to export');
                return;
            }

            const url = `/api/export-csv?searchType=${lastSearchType}&query=${encodeURIComponent(lastSearchQuery)}`;
            window.location.href = url;
        }

        function clearBatchSearch() {
            document.getElementById('batchSearchInput').value = '';
            document.getElementById('resultsContainer').style.display = 'none';
        }

        function clearAdvancedFilters() {
            document.getElementById('filterPowerState').value = '';
            document.getElementById('filterGuestOs').value = '';
            document.getElementById('filterMemory').value = '';
            document.getElementById('filterCpu').value = '';
            document.getElementById('filterToolsStatus').value = '';
            document.getElementById('resultsContainer').style.display = 'none';
        }

        function showLoading() {
            document.getElementById('loading').style.display = 'block';
            document.getElementById('resultsContent').innerHTML = '';
        }

        function hideLoading() {
            document.getElementById('loading').style.display = 'none';
        }

        function showError(message) {
            document.getElementById('resultsContent').innerHTML = `<div class="alert alert-error">${message}</div>`;
            document.getElementById('resultsContainer').style.display = 'block';
            hideLoading();
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Update last updated timestamp
        function updateTimestamp() {
            const now = new Date();
            document.getElementById('lastUpdated').textContent = 
                `Last updated: ${now.toLocaleDateString()} ${now.toLocaleTimeString()} • Auto-refreshes hourly`;
        }

        updateTimestamp();
    </script>
</body>
</html>
