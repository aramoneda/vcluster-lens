pipeline {
    agent { label 'EDDVWJMPA032_ics-globl-manila' }

    options {
        timestamps()
        timeout(time: 1, unit: 'HOURS')
    }

    environment {
        SCRIPT_DIR          = ********
        PS_SCRIPT           = ********
        OUTPUT_JSON         = ********
        REPO_DIR            = ********
        TARGET_JSON         = ********
        GIT_BRANCH          = ********
        VERCEL_API_URL      = ********
        VERCEL_TEAM_ID      = ********
        VERCEL_PROJECT_ID   = ********
        VERCEL_PROJECT_NAME = ********
    }

    stages {
        stage('Prepare') {
            steps {
                powershell '''
                    Write-Output "Preparing run..."
                    Write-Output "Script             : $env:PS_SCRIPT"
                    Write-Output "Output JSON        : $env:OUTPUT_JSON"
                    Write-Output "Repo Dir           : $env:REPO_DIR"
                    Write-Output "Target JSON        : $env:TARGET_JSON"
                    Write-Output "Branch             : $env:GIT_BRANCH"
                    Write-Output "Vercel Project ID  : $env:VERCEL_PROJECT_ID"
                    Write-Output "Vercel Project Name: $env:VERCEL_PROJECT_NAME"
                    Write-Output "Vercel Team ID     : $env:VERCEL_TEAM_ID"

                    if (-not (Test-Path $env:PS_SCRIPT)) {
                        throw "PowerShell script not found: $env:PS_SCRIPT"
                    }

                    if (-not (Test-Path $env:REPO_DIR)) {
                        throw "Repo directory not found: $env:REPO_DIR"
                    }

                    $outputParent = Split-Path $env:OUTPUT_JSON -Parent
                    if (-not (Test-Path $outputParent)) {
                        New-Item -ItemType Directory -Path $outputParent -Force | Out-Null
                    }

                    $targetParent = Split-Path $env:TARGET_JSON -Parent
                    if (-not (Test-Path $targetParent)) {
                        throw "Target directory not found: $targetParent"
                    }
                '''
            }
        }

        stage('Generate JSON') {
            steps {
                powershell '''
                    Write-Output "Running inventory collector..."
                    Set-Location $env:SCRIPT_DIR

                    & $env:PS_SCRIPT

                    if ($LASTEXITCODE -ne 0) {
                        throw "Collector failed with exit code: $LASTEXITCODE"
                    }

                    if (-not (Test-Path $env:OUTPUT_JSON)) {
                        throw "Expected JSON not found: $env:OUTPUT_JSON"
                    }

                    Write-Output "Generated JSON successfully."
                    Write-Output "Size: $((Get-Item $env:OUTPUT_JSON).Length) bytes"
                '''
            }
        }

        stage('Validate JSON') {
            steps {
                powershell '''
                    if (-not (Test-Path $env:OUTPUT_JSON)) {
                        throw "JSON file not found: $env:OUTPUT_JSON"
                    }

                    try {
                        $json = Get-Content $env:OUTPUT_JSON -Raw
                        $data = $json | ConvertFrom-Json

                        Write-Output "JSON validation successful."
                        Write-Output "Record count: $($data.Count)"

                        if ($data.Count -eq 0) {
                            throw "JSON contains zero records."
                        }

                        $first = $data[0]
                        $requiredFields = @('vm_name','vcenter','power_state','site')

                        $missing = @()
                        foreach ($field in $requiredFields) {
                            if (-not ($field -in $first.PSObject.Properties.Name)) {
                                $missing += $field
                            }
                        }

                        if ($missing.Count -gt 0) {
                            throw "Missing required fields: $($missing -join ', ')"
                        }

                        Write-Output "Required fields validated."
                    }
                    catch {
                        throw "JSON validation failed: $($_.Exception.Message)"
                    }
                '''
            }
        }

        stage('Prepare Git Safe Directory') {
            steps {
                powershell '''
                    Write-Output "Configuring git safe.directory for Jenkins runtime user..."
                    $currentSafeDirs = git config --global --get-all safe.directory 2>$null

                    if ($currentSafeDirs -notcontains $env:REPO_DIR) {
                        git config --global --add safe.directory "$env:REPO_DIR"
                    }

                    Write-Output "Configured safe directories:"
                    git config --global --get-all safe.directory
                '''
            }
        }

        stage('Git Status') {
            steps {
                dir(********) {
                    bat '''
git status
git branch --show-current
git remote -v
'''
                }
            }
        }

        stage('Commit and Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-vcluster-push', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_PASSWORD')]) {
                    powershell '''
                        $remoteUrl = (git -C $env:REPO_DIR remote get-url origin).Trim()
                        if (-not $remoteUrl) {
                            throw "Could not get git remote URL."
                        }

                        if ($remoteUrl -notmatch '^https://') {
                            throw "Remote URL is not HTTPS. Current URL: $remoteUrl"
                        }

                        $escapedUser = [System.Uri]::EscapeDataString($env:GIT_USERNAME)
                        $escapedPass = [System.Uri]::EscapeDataString($env:GIT_PASSWORD)
                        $authUrl = $remoteUrl -replace '^https://', "https://$escapedUser`:$escapedPass@"

                        Set-Content -Path (Join-Path $env:REPO_DIR ".git\\jenkins_auth_url.txt") -Value $authUrl -Encoding ASCII
                        Write-Output "Prepared authenticated Git URL."
                    '''

                    dir(********) {
                        bat '''
set /p AUTH_URL=<.git\\jenkins_auth_url.txt

git checkout %GIT_BRANCH%
if errorlevel 1 exit /b 1

git fetch %AUTH_URL% %GIT_BRANCH%
if errorlevel 1 exit /b 1

git reset --hard FETCH_HEAD
if errorlevel 1 exit /b 1
'''
                    }

                    powershell '''
                        Write-Output "Copying JSON into repo target..."
                        Copy-Item -Path $env:OUTPUT_JSON -Destination $env:TARGET_JSON -Force

                        if (-not (Test-Path $env:TARGET_JSON)) {
                            throw "Copy failed. Target file not found: $env:TARGET_JSON"
                        }
                    '''

                    dir(********) {
                        bat '''
git add lib\\vm-inventory.json
if errorlevel 1 exit /b 1

git status --porcelain > git_status.txt
if errorlevel 1 exit /b 1

for %%A in (git_status.txt) do if %%~zA==0 (
    echo No changes detected in lib\\vm-inventory.json. Nothing to commit.
    del /f /q git_status.txt >nul 2>nul
    exit /b 0
)

echo Git status after add:
type git_status.txt

git config user.name Jenkins
if errorlevel 1 exit /b 1

git config user.email aeramoneda@gmail.com
if errorlevel 1 exit /b 1

git commit -m "Update vm inventory"
if errorlevel 1 exit /b 1

set /p AUTH_URL=<.git\\jenkins_auth_url.txt
git push %AUTH_URL% HEAD:%GIT_BRANCH%
if errorlevel 1 exit /b 1

del /f /q git_status.txt >nul 2>nul
echo Changes committed and pushed successfully.
'''
                    }
                }
            }
        }

        stage('Create Production Redeploy in Vercel') {
            steps {
                withCredentials([string(credentialsId: 'vercel-api-token', variable: 'VERCEL_TOKEN')]) {
                    powershell '''
                        $ErrorActionPreference = "Stop"

                        Write-Output ""
                        Write-Output "[Vercel] Waiting briefly before checking deployments..."
                        Start-Sleep -Seconds 5

                        if ([string]::IsNullOrWhiteSpace($env:VERCEL_TOKEN)) {
                            throw "VERCEL_TOKEN is empty or not injected from Jenkins credentials."
                        }

                        $headers = @{
                            "Authorization" = "Bearer $env:VERCEL_TOKEN"
                            "Content-Type"  = "application/json"
                        }

                        $apiUrl      = $env:VERCEL_API_URL.TrimEnd('/')
                        $teamId      = $env:VERCEL_TEAM_ID
                        $projectName = $env:VERCEL_PROJECT_NAME
                        $projectId   = $env:VERCEL_PROJECT_ID

                        try {
                            $lookupUrl = $apiUrl + "/v6/deployments?limit=10"
                            Write-Output "[Vercel] Looking up recent deployments..."
                            Write-Output "[Vercel] Lookup URL: $lookupUrl"

                            $lookupResponse = Invoke-WebRequest -Uri $lookupUrl -Method GET -Headers $headers -UseBasicParsing
                            $deployments = $lookupResponse.Content | ConvertFrom-Json

                            if (-not $deployments.deployments -or $deployments.deployments.Count -eq 0) {
                                throw "No deployments returned by Vercel."
                            }

                            $vcDeployment = $deployments.deployments |
                                Where-Object { $_.name -eq $projectName } |
                                Select-Object -First 1

                            if (-not $vcDeployment) {
                                throw "Could not find deployment for project name [$projectName] in recent deployments."
                            }

                            $deploymentId = $vcDeployment.uid
                            $deploymentState = $vcDeployment.state

                            Write-Output "[Vercel] Found deployment:"
                            Write-Output "[Vercel] Deployment ID   : $deploymentId"
                            Write-Output "[Vercel] Deployment Name : $($vcDeployment.name)"
                            Write-Output "[Vercel] Deployment State: $deploymentState"
                            Write-Output "[Vercel] Deployment URL  : $($vcDeployment.url)"

                            $redeployUrl = $apiUrl + "/v13/deployments?teamId=" + $teamId

                            $bodyObject = @{
                                name             = $projectName
                                project          = $projectId
                                target           = "production"
                                deploymentId     = $deploymentId
                                withLatestCommit = $true
                            }

                            $bodyJson = $bodyObject | ConvertTo-Json -Depth 10

                            Write-Output ""
                            Write-Output "[Vercel] Creating production redeploy..."
                            Write-Output "[Vercel] Redeploy URL: $redeployUrl"
                            Write-Output "[Vercel] Request Body:"
                            Write-Output $bodyJson

                            $redeployResponse = Invoke-WebRequest `
                                -Uri $redeployUrl `
                                -Method POST `
                                -Headers $headers `
                                -Body $bodyJson `
                                -UseBasicParsing

                            $redeployData = $redeployResponse.Content | ConvertFrom-Json

                            Write-Output ""
                            Write-Output "[Vercel] SUCCESS: Production redeploy created"
                            Write-Output "[Vercel] Status Code       : $($redeployResponse.StatusCode)"
                            Write-Output "[Vercel] New Deployment ID : $($redeployData.id)"
                            Write-Output "[Vercel] New Deployment URL: $($redeployData.url)"
                            Write-Output "[Vercel] Ready State       : $($redeployData.readyState)"
                            Write-Output "[Vercel] Target            : $($redeployData.target)"
                        }
                        catch {
                            Write-Output ""
                            Write-Output "[Vercel] FAILED"
                            Write-Output "[Vercel] Error: $($_.Exception.Message)"

                            if ($_.Exception.Response) {
                                Write-Output "[Vercel] Response Status: $($_.Exception.Response.StatusCode)"
                                try {
                                    $reader = New-Object System.IO.StreamReader($_.Exception.Response.GetResponseStream())
                                    $reader.BaseStream.Position = 0
                                    $reader.DiscardBufferedData()
                                    $responseBody = $reader.ReadToEnd()
                                    Write-Output "[Vercel] Response Body:"
                                    Write-Output $responseBody
                                }
                                catch {
                                    Write-Output "[Vercel] Could not read response body."
                                }
                            }

                            throw
                        }
                    '''
                }
            }
        }
    }

    post {
        always {
            powershell '''
                $authFile = Join-Path $env:REPO_DIR ".git\\jenkins_auth_url.txt"
                if (Test-Path $authFile) {
                    Remove-Item $authFile -Force -ErrorAction SilentlyContinue
                }

                Write-Output ""
                Write-Output "=========================================="
                Write-Output "Pipeline Execution Completed"
                Write-Output "=========================================="
                Write-Output ""
            '''
        }

        success {
            powershell '''
                Write-Output "[SUCCESS] Pipeline completed successfully"
                Write-Output "JSON generated and validated"
                Write-Output "JSON pushed to GitHub"
                Write-Output "Production redeploy created in Vercel"
                Write-Output "Check Vercel dashboard for deployment progress"
            '''
        }

        failure {
            powershell '''
                Write-Output "[FAILURE] Pipeline failed - check logs above"
                Write-Output "Common issues:"
                Write-Output "- JSON validation failed"
                Write-Output "- Git credentials/configuration issue"
                Write-Output "- Vercel token/team/project issue"
                Write-Output "- Vercel redeploy API request issue"
            '''
        }
    }
}
