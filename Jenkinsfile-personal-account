pipeline {
    agent { label 'EDDVWJMPA032_ics-globl-manila' }

    options {
        timestamps()
        timeout(time: 1, unit: 'HOURS')
    }

    environment {
        SCRIPT_DIR   = "${SCRIPT_DIR}"
        PS_SCRIPT    = "${PS_SCRIPT}"
        OUTPUT_JSON  = "${OUTPUT_JSON}"
        REPO_DIR     = "${REPO_DIR}"
        TARGET_JSON  = "${TARGET_JSON}"
        GIT_BRANCH   = "${GIT_BRANCH}"
        GIT_EMAIL    = "jenkins@broadridge.com"
        GIT_USER     = "Jenkins Automation"
    }

    stages {
        stage('Prepare') {
            steps {
                powershell '''
                    Write-Output "=========================================="
                    Write-Output "vCluster Lens - Jenkins Automation Pipeline"
                    Write-Output "=========================================="
                    Write-Output "Target: Personal Vercel Account (Hobby)"
                    Write-Output ""
                    Write-Output "Configuration:"
                    Write-Output "  Script Dir    : $env:SCRIPT_DIR"
                    Write-Output "  PS Script     : $env:PS_SCRIPT"
                    Write-Output "  Output JSON   : $env:OUTPUT_JSON"
                    Write-Output "  Repo Dir      : $env:REPO_DIR"
                    Write-Output "  Target JSON   : $env:TARGET_JSON"
                    Write-Output "  Git Branch    : $env:GIT_BRANCH"
                    Write-Output "  Git User      : $env:GIT_USER"
                    Write-Output "  Git Email     : $env:GIT_EMAIL"
                    Write-Output ""

                    if (-not (Test-Path $env:PS_SCRIPT)) {
                        throw "PowerShell script not found: $env:PS_SCRIPT"
                    }

                    if (-not (Test-Path $env:REPO_DIR)) {
                        throw "Repo directory not found: $env:REPO_DIR"
                    }

                    $outputParent = Split-Path $env:OUTPUT_JSON -Parent
                    if (-not (Test-Path $outputParent)) {
                        New-Item -ItemType Directory -Path $outputParent -Force | Out-Null
                    }

                    $targetParent = Split-Path $env:TARGET_JSON -Parent
                    if (-not (Test-Path $targetParent)) {
                        throw "Target directory not found: $targetParent"
                    }

                    Write-Output "[Prepare] All validation checks passed"
                '''
            }
        }

        stage('Generate JSON') {
            steps {
                powershell '''
                    Write-Output ""
                    Write-Output "[Generate] Starting VM Inventory Collection..."
                    Set-Location $env:SCRIPT_DIR

                    & $env:PS_SCRIPT

                    if ($LASTEXITCODE -ne 0) {
                        throw "Collector failed with exit code: $LASTEXITCODE"
                    }

                    if (-not (Test-Path $env:OUTPUT_JSON)) {
                        throw "Expected JSON not found: $env:OUTPUT_JSON"
                    }

                    $fileSize = (Get-Item $env:OUTPUT_JSON).Length
                    $fileSizeMB = [math]::Round($fileSize / 1MB, 2)
                    
                    Write-Output "[Generate] SUCCESS - JSON generated"
                    Write-Output "[Generate] File size: $fileSizeMB MB"
                '''
            }
        }

        stage('Validate JSON') {
            steps {
                powershell '''
                    Write-Output ""
                    Write-Output "[Validate] Validating JSON structure..."

                    if (-not (Test-Path $env:OUTPUT_JSON)) {
                        throw "JSON file not found: $env:OUTPUT_JSON"
                    }

                    try {
                        $json = Get-Content $env:OUTPUT_JSON -Raw
                        $data = $json | ConvertFrom-Json

                        $recordCount = if ($data -is [array]) { $data.Count } else { 1 }
                        
                        Write-Output "[Validate] JSON is valid"
                        Write-Output "[Validate] Record count: $recordCount"

                        if ($recordCount -eq 0) {
                            throw "JSON contains zero records"
                        }

                        $first = if ($data -is [array]) { $data[0] } else { $data }
                        $requiredFields = @('vm_name','vcenter','power_state','site','provisioned_gb','used_gb','vm_compatibility')

                        $missing = @()
                        foreach ($field in $requiredFields) {
                            if (-not ($field -in $first.PSObject.Properties.Name)) {
                                $missing += $field
                            }
                        }

                        if ($missing.Count -gt 0) {
                            throw "Missing required fields: $($missing -join ', ')"
                        }

                        Write-Output "[Validate] All required fields present"
                        Write-Output "[Validate] SUCCESS - JSON is valid and ready"
                    }
                    catch {
                        Write-Error "JSON validation failed: $_"
                        throw $_
                    }
                '''
            }
        }

        stage('Copy to Repository') {
            steps {
                powershell '''
                    Write-Output ""
                    Write-Output "[Copy] Copying JSON to repository..."

                    if (-not (Test-Path $env:OUTPUT_JSON)) {
                        throw "Source JSON not found: $env:OUTPUT_JSON"
                    }

                    $targetDir = Split-Path $env:TARGET_JSON -Parent
                    if (-not (Test-Path $targetDir)) {
                        New-Item -ItemType Directory -Path $targetDir -Force | Out-Null
                    }

                    Copy-Item -Path $env:OUTPUT_JSON -Destination $env:TARGET_JSON -Force
                    
                    if (-not (Test-Path $env:TARGET_JSON)) {
                        throw "Failed to copy JSON to: $env:TARGET_JSON"
                    }

                    Write-Output "[Copy] SUCCESS - JSON copied to repository"
                '''
            }
        }

        stage('Git Configuration') {
            steps {
                dir("${REPO_DIR}") {
                    powershell '''
                        Write-Output ""
                        Write-Output "[Git] Configuring Git..."
                        
                        git config user.email $env:GIT_EMAIL
                        git config user.name $env:GIT_USER
                        
                        $currentUser = git config user.name
                        $currentEmail = git config user.email
                        
                        Write-Output "[Git] User configured: $currentUser ($currentEmail)"
                    '''
                }
            }
        }

        stage('Commit and Push') {
            steps {
                dir("${REPO_DIR}") {
                    powershell '''
                        Write-Output ""
                        Write-Output "[Git] Checking for changes..."
                        
                        $status = git status --porcelain
                        
                        if ([string]::IsNullOrEmpty($status)) {
                            Write-Output "[Git] No changes detected - skipping commit"
                            return
                        }

                        Write-Output "[Git] Changes detected:"
                        Write-Output $status
                        
                        Write-Output ""
                        Write-Output "[Git] Staging changes..."
                        git add -A
                        
                        Write-Output "[Git] Committing changes..."
                        $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
                        git commit -m "Update VM inventory - $timestamp"
                        
                        if ($LASTEXITCODE -ne 0) {
                            throw "Git commit failed with exit code: $LASTEXITCODE"
                        }

                        Write-Output "[Git] Pushing to remote..."
                        git push origin $env:GIT_BRANCH
                        
                        if ($LASTEXITCODE -ne 0) {
                            throw "Git push failed with exit code: $LASTEXITCODE"
                        }

                        Write-Output "[Git] SUCCESS - Changes pushed to GitHub"
                        Write-Output "[Git] Vercel will auto-deploy in 1-2 minutes"
                    '''
                }
            }
        }
    }

    post {
        success {
            powershell '''
                Write-Output "[SUCCESS] Pipeline completed successfully"
                Write-Output "JSON generated, committed, and pushed to GitHub"
                Write-Output "Vercel will auto-deploy to production via GitHub webhook"
                Write-Output "Dashboard will update within 2-3 minutes"
            '''
        }

                        $headers = @{
                            "Authorization" = "Bearer $token"
                            "Content-Type"  = "application/json"
                        }

                        try {
                            # Get all recent deployments (without project filter)
                            Write-Output "[Promote] Fetching recent deployments..."
                            $url = "https://api.vercel.com/v6/deployments?limit=3"
                            
                            $response = Invoke-WebRequest -Uri $url -Method GET -Headers $headers -UseBasicParsing
                            $deployments = $response.Content | ConvertFrom-Json
                            
                            if ($deployments.deployments.Count -eq 0) {
                                Write-Output "[Promote] No deployments found."
                                exit 0
                            }

                            # Find the vcluster-lens deployment
                            $vcDeployment = $deployments.deployments | Where-Object { $_.name -eq "vcluster-lens" } | Select-Object -First 1
                            
                            if (-not $vcDeployment) {
                                Write-Output "[Promote] vcluster-lens deployment not found in recent deployments."
                                exit 0
                            }

                            $deploymentId = $vcDeployment.uid
                            $deploymentState = $vcDeployment.state
                            
                            Write-Output "[Promote] Found vcluster-lens deployment"
                            Write-Output "[Promote] Deployment ID: $deploymentId"
                            Write-Output "[Promote] Current State: $deploymentState"

                            # Always attempt to promote
                            if ($deploymentState -eq "READY") {
                                Write-Output "[Promote] Promoting deployment to Production..."
                                
                                $promoteUrl = "https://api.vercel.com/v13/deployments/$deploymentId/promote"
                                $promoteResponse = Invoke-WebRequest -Uri $promoteUrl -Method POST -Headers $headers -UseBasicParsing
                                
                                Write-Output "[Promote] SUCCESS: Deployment promoted to Production!"
                                Write-Output "[Promote] Status Code: $($promoteResponse.StatusCode)"
                            } else {
                                Write-Output "[Promote] Deployment is in $deploymentState state."
                                Write-Output "[Promote] Note: Will attempt promotion when ready via GitHub webhook."
                            }
                        }
                        catch {
                            Write-Output "[Promote] API Error: $($_.Exception.Message)"
                            Write-Output "[Promote] Note: Vercel will auto-promote via GitHub webhook (no action required)."
                            exit 0
                        }
                    '''
                }
            }
        }
    }

    post {
        always {
            powershell '''
                Write-Output ""
                Write-Output "=========================================="
                Write-Output "Pipeline Execution Completed"
                Write-Output "=========================================="
                Write-Output ""
                Write-Output "Next Steps:"
                Write-Output "1. Monitor GitHub for new commit"
                Write-Output "2. Check Vercel dashboard for deployment"
                Write-Output "3. Verify dashboard updates in ~2-3 minutes"
                Write-Output ""
            '''
        }

        success {
            powershell '''
                Write-Output "[SUCCESS] Pipeline completed successfully"
                Write-Output "JSON generated, committed, and pushed to GitHub"
                Write-Output "Vercel deployment triggered and promoted to Production"
                Write-Output "Dashboard will update within 2-3 minutes"
            '''
        }

        failure {
            powershell '''
                Write-Output "[FAILURE] Pipeline failed - check logs above"
                Write-Output "Common issues:"
                Write-Output "- JSON validation failed (check data format)"
                Write-Output "- Git configuration missing (check credentials)"
                Write-Output "- Network connectivity issues"
            '''
        }
    }
}
