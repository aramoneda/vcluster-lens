@{
    ViewData["Title"] = "ICS SRE vCenter Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: #0f172a;
            color: #e2e8f0;
        }

        .header {
            background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);
            padding: 3rem 2rem;
            text-align: center;
            border-bottom: 1px solid #1e293b;
        }

        .header h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            letter-spacing: -0.02em;
        }

        .header p {
            font-size: 1.125rem;
            color: #cbd5e1;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        .error-message {
            background-color: #7f1d1d;
            border: 1px solid #dc2626;
            color: #fecaca;
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 2rem;
        }

        /* Analytics Cards Grid */
        .analytics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 0.75rem;
            padding: 1.5rem;
            border-left: 4px solid #3b82f6;
        }

        .card.vcenters-card { border-left-color: #06b6d4; }
        .card.powered-on-card { border-left-color: #10b981; }
        .card.powered-off-card { border-left-color: #ef4444; }
        .card.storage-card { border-left-color: #a855f7; }
        .card.memory-card { border-left-color: #f97316; }

        .card-label {
            font-size: 0.875rem;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        .card-value {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .card-detail {
            font-size: 0.875rem;
            color: #64748b;
        }

        /* Search Sections */
        .search-section {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 0.75rem;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .search-section h2 {
            display: flex;
            align-items: center;
            font-size: 1.25rem;
            margin-bottom: 1.5rem;
            gap: 0.75rem;
        }

        .search-icon {
            font-size: 1.5rem;
        }

        /* Input Group */
        .input-group {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }

        input, select {
            flex: 1;
            min-width: 200px;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 0.5rem;
            padding: 0.75rem 1rem;
            color: #e2e8f0;
            font-size: 1rem;
        }

        input::placeholder {
            color: #64748b;
        }

        input:focus, select:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 0.5rem;
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.2s;
        }

        .btn-primary {
            background: #3b82f6;
            color: white;
        }

        .btn-primary:hover {
            background: #2563eb;
        }

        .btn-secondary {
            background: #475569;
            color: white;
        }

        .btn-secondary:hover {
            background: #334155;
        }

        .btn-success {
            background: #10b981;
            color: white;
        }

        .btn-success:hover {
            background: #059669;
        }

        /* Advanced Filters */
        .advanced-filters {
            display: none;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 0.5rem;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .advanced-filters.show {
            display: block;
        }

        .filter-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
        }

        .filter-group label {
            font-size: 0.875rem;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        /* Results Table */
        .results-container {
            margin-top: 2rem;
            display: none;
        }

        .results-container.show {
            display: block;
        }

        .results-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .results-header h3 {
            font-size: 1.125rem;
        }

        .results-count {
            color: #94a3b8;
            font-size: 0.875rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 0.5rem;
            overflow: hidden;
        }

        thead {
            background: #1e293b;
            border-bottom: 1px solid #334155;
        }

        th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            font-size: 0.875rem;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        td {
            padding: 1rem;
            border-bottom: 1px solid #334155;
            font-size: 0.875rem;
        }

        tbody tr:hover {
            background: #1e293b;
        }

        .power-state-on {
            color: #10b981;
        }

        .power-state-off {
            color: #ef4444;
        }

        /* Utility */
        .last-updated {
            text-align: right;
            color: #64748b;
            font-size: 0.875rem;
            margin-top: 2rem;
        }

        .loading {
            text-align: center;
            padding: 2rem;
            color: #94a3b8;
        }

        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #334155;
            border-top-color: #3b82f6;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>ICS SRE vCenter Dashboard</h1>
        <p>VM Search & Resource Analytics</p>
    </div>

    <div class="container">
        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="error-message">
                <strong>Error:</strong> @ViewBag.Error
            </div>
        }

        <!-- Analytics Cards -->
        <div class="analytics-grid">
            <div class="card">
                <div class="card-label">Total VMs</div>
                <div class="card-value" id="totalVms">-</div>
                <div class="card-detail" id="totalVmsOnline">-</div>
            </div>
            <div class="card vcenters-card">
                <div class="card-label">vCenters</div>
                <div class="card-value" id="vcentersCount">-</div>
                <div class="card-detail">Active Sites</div>
            </div>
            <div class="card powered-on-card">
                <div class="card-label">Powered On</div>
                <div class="card-value" id="poweredOn">-</div>
                <div class="card-detail" id="poweredOnPercent">-</div>
            </div>
            <div class="card powered-off-card">
                <div class="card-label">Powered Off</div>
                <div class="card-value" id="poweredOff">-</div>
                <div class="card-detail" id="poweredOffStorage">-</div>
            </div>
            <div class="card storage-card">
                <div class="card-label">Storage Utilization</div>
                <div class="card-value" id="storageUtil">-</div>
                <div class="card-detail">0.0 TB of 0.0 TB</div>
            </div>
            <div class="card memory-card">
                <div class="card-label">Memory Allocation</div>
                <div class="card-value" id="memoryAlloc">-</div>
                <div class="card-detail">0.0 GB of 0.0 GB</div>
            </div>
        </div>

        <!-- Search: Single VM -->
        <div class="search-section">
            <h2><span class="search-icon">🔍</span> Search Single VM</h2>
            <div class="input-group">
                <input type="text" id="singleVmSearch" placeholder="Search by VM name (supports wildcards: edp*, *qa*, etc.)">
                <button class="btn btn-primary" onclick="searchSingleVm()">Search</button>
            </div>
            <div id="singleVmResults" class="results-container">
                <div class="results-header">
                    <h3>Search Results</h3>
                    <span class="results-count" id="singleVmCount"></span>
                    <button class="btn btn-success" onclick="exportToCSV('singleVmTable')">Export to CSV</button>
                </div>
                <table id="singleVmTable">
                    <thead>
                        <tr>
                            <th>VM Name</th>
                            <th>Power State</th>
                            <th>Hostname</th>
                            <th>vCenter</th>
                            <th>CPU</th>
                            <th>Memory GB</th>
                            <th>ESXi Host</th>
                        </tr>
                    </thead>
                    <tbody id="singleVmBody"></tbody>
                </table>
            </div>
        </div>

        <!-- Search: vCenter with Advanced Filters -->
        <div class="search-section">
            <h2><span class="search-icon">🖥️</span> Search by vCenter</h2>
            <div class="input-group">
                <select id="vCenterSelect" onchange="onVCenterSelected()">
                    <option value="">-- Select vCenter --</option>
                </select>
                <button class="btn btn-primary" onclick="searchVCenter()">Search</button>
            </div>

            <!-- Advanced Filters (hidden until vCenter selected) -->
            <div id="advancedFilters" class="advanced-filters">
                <h3 style="margin-bottom: 1rem;">Advanced Filtering (Optional)</h3>
                <div class="filter-grid">
                    <div class="filter-group">
                        <label>Power State</label>
                        <select id="filterPowerState">
                            <option value="">All States</option>
                            <option value="poweredOn">Powered On</option>
                            <option value="poweredOff">Powered Off</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Guest OS</label>
                        <select id="filterGuestOs">
                            <option value="">All OSes</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Min Memory (GB)</label>
                        <input type="number" id="filterMinMemory" min="0" placeholder="0">
                    </div>
                    <div class="filter-group">
                        <label>Max Memory (GB)</label>
                        <input type="number" id="filterMaxMemory" min="0" placeholder="999">
                    </div>
                    <div class="filter-group">
                        <label>Min CPU Cores</label>
                        <input type="number" id="filterMinCpu" min="0" placeholder="0">
                    </div>
                    <div class="filter-group">
                        <label>Max CPU Cores</label>
                        <input type="number" id="filterMaxCpu" min="0" placeholder="999">
                    </div>
                </div>
                <button class="btn btn-secondary" onclick="searchVCenter()">Apply Filters</button>
                <button class="btn btn-secondary" onclick="clearAdvancedFilters()">Clear Filters</button>
            </div>

            <div id="vCenterResults" class="results-container">
                <div class="results-header">
                    <h3>Search Results</h3>
                    <span class="results-count" id="vCenterCount"></span>
                    <button class="btn btn-success" onclick="exportToCSV('vCenterTable')">Export to CSV</button>
                </div>
                <table id="vCenterTable">
                    <thead>
                        <tr>
                            <th>VM Name</th>
                            <th>Power State</th>
                            <th>Hostname</th>
                            <th>CPU</th>
                            <th>Memory GB</th>
                            <th>Provisioned GB</th>
                            <th>Used GB</th>
                            <th>ESXi Host</th>
                            <th>Tools Status</th>
                        </tr>
                    </thead>
                    <tbody id="vCenterBody"></tbody>
                </table>
            </div>
        </div>

        <!-- Search: Multiple VMs -->
        <div class="search-section">
            <h2><span class="search-icon">📋</span> Search Multiple VMs</h2>
            <div class="input-group">
                <textarea id="multipleVmSearch" style="padding: 0.75rem 1rem; height: 80px;" placeholder="Enter VM names separated by commas (e.g., vm1, vm2, vm3)"></textarea>
                <button class="btn btn-primary" onclick="searchMultipleVms()" style="align-self: flex-end;">Search</button>
            </div>
            <div id="multipleVmResults" class="results-container">
                <div class="results-header">
                    <h3>Search Results</h3>
                    <span class="results-count" id="multipleVmCount"></span>
                    <button class="btn btn-success" onclick="exportToCSV('multipleVmTable')">Export to CSV</button>
                </div>
                <table id="multipleVmTable">
                    <thead>
                        <tr>
                            <th>VM Name</th>
                            <th>Power State</th>
                            <th>Hostname</th>
                            <th>vCenter</th>
                            <th>CPU</th>
                            <th>Memory GB</th>
                            <th>Cluster</th>
                        </tr>
                    </thead>
                    <tbody id="multipleVmBody"></tbody>
                </table>
            </div>
        </div>

        <div class="last-updated">
            Last updated: <span id="lastUpdated">Never</span> • Auto-refreshes hourly
        </div>
    </div>

    <script>
        // Load dashboard on page load
        window.addEventListener('DOMContentLoaded', function() {
            loadDashboardSummary();
            loadVCenters();
        });

        function loadDashboardSummary() {
            fetch('/api/dashboard-summary')
                .then(r => r.json())
                .then(data => {
                    if (data.error) {
                        console.error('Dashboard error:', data.error);
                        return;
                    }
                    document.getElementById('totalVms').textContent = data.totalVms?.toLocaleString() || '0';
                    document.getElementById('totalVmsOnline').textContent = data.vcenters + ' Online';
                    document.getElementById('vcentersCount').textContent = data.vcenters || '0';
                    document.getElementById('poweredOn').textContent = data.poweredOn?.toLocaleString() || '0';
                    document.getElementById('poweredOnPercent').textContent = Math.round((data.poweredOn / data.totalVms) * 100) + '% of total';
                    document.getElementById('poweredOff').textContent = data.poweredOff?.toLocaleString() || '0';
                    document.getElementById('storageUtil').textContent = (data.storageUtilization || 0) + '%';
                    document.getElementById('memoryAlloc').textContent = (data.memoryAllocation || 0) + '%';
                    document.getElementById('lastUpdated').textContent = new Date().toLocaleString();
                })
                .catch(err => console.error('Error loading dashboard:', err));
        }

        function loadVCenters() {
            fetch('/api/dashboard-summary')
                .then(r => r.json())
                .then(data => {
                    if (data.error) return;
                    // vCenters will be populated from the page load
                    const vCenters = @Html.Raw(Json.Serialize((List<string>)ViewBag.VCenters ?? new List<string>()));
                    const select = document.getElementById('vCenterSelect');
                    vCenters.forEach(vcenter => {
                        const option = document.createElement('option');
                        option.value = vcenter;
                        option.textContent = vcenter;
                        select.appendChild(option);
                    });
                })
                .catch(err => console.error('Error loading vCenters:', err));
        }

        function onVCenterSelected() {
            const selected = document.getElementById('vCenterSelect').value;
            const filters = document.getElementById('advancedFilters');
            if (selected) {
                filters.classList.add('show');
            } else {
                filters.classList.remove('show');
            }
        }

        function searchSingleVm() {
            const term = document.getElementById('singleVmSearch').value;
            if (!term) {
                alert('Please enter a search term');
                return;
            }
            fetch('/api/search-single-vm', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ searchTerm: term })
            })
            .then(r => r.json())
            .then(data => {
                renderResults(data.data, 'singleVmBody', 'singleVmResults', 'singleVmCount', data.count);
            })
            .catch(err => console.error('Search error:', err));
        }

        function searchVCenter() {
            const vcenter = document.getElementById('vCenterSelect').value;
            if (!vcenter) {
                alert('Please select a vCenter');
                return;
            }
            const request = {
                vCenterName: vcenter,
                powerState: document.getElementById('filterPowerState').value || null,
                guestOs: document.getElementById('filterGuestOs').value || null,
                minMemory: document.getElementById('filterMinMemory').value ? parseFloat(document.getElementById('filterMinMemory').value) : null,
                maxMemory: document.getElementById('filterMaxMemory').value ? parseFloat(document.getElementById('filterMaxMemory').value) : null,
                minCpu: document.getElementById('filterMinCpu').value ? parseInt(document.getElementById('filterMinCpu').value) : null,
                maxCpu: document.getElementById('filterMaxCpu').value ? parseInt(document.getElementById('filterMaxCpu').value) : null
            };
            fetch('/api/search-vcenter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(request)
            })
            .then(r => r.json())
            .then(data => {
                renderResults(data.data, 'vCenterBody', 'vCenterResults', 'vCenterCount', data.count);
            })
            .catch(err => console.error('Search error:', err));
        }

        function searchMultipleVms() {
            const terms = document.getElementById('multipleVmSearch').value;
            if (!terms) {
                alert('Please enter VM names');
                return;
            }
            fetch('/api/search-multiple-vms', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ searchTerms: terms })
            })
            .then(r => r.json())
            .then(data => {
                renderResults(data.data, 'multipleVmBody', 'multipleVmResults', 'multipleVmCount', data.count);
            })
            .catch(err => console.error('Search error:', err));
        }

        function renderResults(vms, bodyId, containerId, countId, count) {
            const tbody = document.getElementById(bodyId);
            tbody.innerHTML = '';
            
            if (!vms || vms.length === 0) {
                tbody.innerHTML = '<tr><td colspan="10" style="text-align: center; padding: 2rem;">No results found</td></tr>';
                document.getElementById(countId).textContent = '0 results';
                document.getElementById(containerId).classList.add('show');
                return;
            }

            vms.forEach(vm => {
                const row = tbody.insertRow();
                row.innerHTML = `
                    <td>${vm.vm_name || '-'}</td>
                    <td><span class="power-state-${vm.power_state === 'poweredOn' ? 'on' : 'off'}">${vm.power_state || '-'}</span></td>
                    <td>${vm.guest_hostname || '-'}</td>
                    <td>${vm.vcenter_name || '-'}</td>
                    <td>${vm.cpu_cores || '-'}</td>
                    <td>${vm.memory_gb || '-'}</td>
                    <td>${vm.storage_provisioned_gb || '-'}</td>
                    <td>${vm.storage_used_gb || '-'}</td>
                    <td>${vm.esxi_host || '-'}</td>
                    <td>${vm.tools_status || '-'}</td>
                `;
            });
            
            document.getElementById(countId).textContent = count + ' result' + (count !== 1 ? 's' : '');
            document.getElementById(containerId).classList.add('show');
        }

        function clearAdvancedFilters() {
            document.getElementById('filterPowerState').value = '';
            document.getElementById('filterGuestOs').value = '';
            document.getElementById('filterMinMemory').value = '';
            document.getElementById('filterMaxMemory').value = '';
            document.getElementById('filterMinCpu').value = '';
            document.getElementById('filterMaxCpu').value = '';
        }

        function exportToCSV(tableId) {
            const table = document.getElementById(tableId);
            const csv = [];
            
            // Headers
            const headers = [];
            table.querySelectorAll('th').forEach(th => headers.push(th.textContent));
            csv.push(headers.join(','));
            
            // Rows
            table.querySelectorAll('tbody tr').forEach(tr => {
                const row = [];
                tr.querySelectorAll('td').forEach(td => row.push('"' + td.textContent.trim() + '"'));
                csv.push(row.join(','));
            });
            
            const blob = new Blob([csv.join('\n')], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'vm-inventory-' + new Date().toISOString().slice(0, 10) + '.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        // Auto-refresh every hour
        setInterval(loadDashboardSummary, 60 * 60 * 1000);
    </script>
</body>
</html>
