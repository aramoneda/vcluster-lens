@{
    ViewData["Title"] = "ICS SRE vCenter Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ICS SRE vCenter Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
    <style>
        :root {
            --bg-primary: #0f1419;
            --bg-secondary: #1a1f2e;
            --bg-tertiary: #242d3d;
            --border-color: #3a4557;
            --text-primary: #ffffff;
            --text-secondary: #a0aec0;
            --accent-blue: #3b82f6;
            --accent-green: #10b981;
            --accent-red: #ef4444;
            --accent-purple: #a855f7;
            --accent-orange: #f97316;
            --accent-cyan: #06b6d4;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--bg-primary);
            color: var(--text-primary);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        .header {
            background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);
            padding: 40px 20px;
            text-align: center;
            border-bottom: 1px solid var(--border-color);
        }

        .header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
            color: var(--text-primary);
        }

        .header p {
            font-size: 1.1rem;
            color: var(--text-secondary);
        }

        .container-fluid {
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px 20px;
        }

        .analytics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .card-metric {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 25px;
            border-left: 4px solid var(--accent-blue);
            transition: transform 0.2s;
        }

        .card-metric:hover {
            transform: translateY(-2px);
        }

        .card-metric.blue {
            border-left-color: var(--accent-blue);
        }

        .card-metric.cyan {
            border-left-color: var(--accent-cyan);
        }

        .card-metric.green {
            border-left-color: var(--accent-green);
        }

        .card-metric.red {
            border-left-color: var(--accent-red);
        }

        .card-metric.purple {
            border-left-color: var(--accent-purple);
        }

        .card-metric.orange {
            border-left-color: var(--accent-orange);
        }

        .metric-label {
            font-size: 0.85rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
        }

        .metric-value {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text-primary);
        }

        .metric-subtitle {
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .section-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin: 30px 0 20px 0;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .search-panel {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
        }

        .search-input-group {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .search-input-group input,
        .search-input-group select {
            flex: 1;
            background: var(--bg-tertiary);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 12px 15px;
            border-radius: 8px;
            font-size: 0.95rem;
        }

        .search-input-group input::placeholder {
            color: var(--text-secondary);
        }

        .search-input-group input:focus,
        .search-input-group select:focus {
            outline: none;
            border-color: var(--accent-blue);
            background: var(--bg-tertiary);
            color: var(--text-primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .btn-search {
            background: var(--accent-blue);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-search:hover {
            background: #2563eb;
        }

        .btn-clear {
            background: var(--bg-tertiary);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-clear:hover {
            background: var(--border-color);
        }

        .btn-export {
            background: var(--accent-green);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            float: right;
            margin: 10px 0;
        }

        .btn-export:hover {
            background: #059669;
        }

        .advanced-filters {
            display: none;
            background: rgba(59, 130, 246, 0.05);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
        }

        .advanced-filters.show {
            display: block;
        }

        .filter-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
        }

        .filter-group label {
            font-size: 0.85rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .filter-group select,
        .filter-group input {
            background: var(--bg-tertiary);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 10px 12px;
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .filter-group select:focus,
        .filter-group input:focus {
            outline: none;
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .filter-buttons {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            grid-column: 1 / -1;
        }

        .results-table {
            width: 100%;
            border-collapse: collapse;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            overflow: hidden;
            margin-top: 20px;
        }

        .results-table thead {
            background: var(--bg-tertiary);
            border-bottom: 1px solid var(--border-color);
        }

        .results-table th {
            padding: 15px;
            text-align: left;
            font-weight: 600;
            color: var(--text-secondary);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .results-table td {
            padding: 12px 15px;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.9rem;
        }

        .results-table tbody tr:hover {
            background: var(--bg-tertiary);
        }

        .results-table tbody tr:last-child td {
            border-bottom: none;
        }

        .power-state {
            padding: 4px 12px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .power-state.on {
            background: rgba(16, 185, 129, 0.2);
            color: var(--accent-green);
        }

        .power-state.off {
            background: rgba(239, 68, 68, 0.2);
            color: var(--accent-red);
        }

        .alert {
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
            border: 1px solid var(--border-color);
        }

        .alert.error {
            background: rgba(239, 68, 68, 0.1);
            color: #fca5a5;
            border-color: rgba(239, 68, 68, 0.3);
        }

        .alert.info {
            background: rgba(59, 130, 246, 0.1);
            color: #93c5fd;
            border-color: rgba(59, 130, 246, 0.3);
        }

        .alert.success {
            background: rgba(16, 185, 129, 0.1);
            color: #86efac;
            border-color: rgba(16, 185, 129, 0.3);
        }

        .alert.show {
            display: block;
        }

        .no-results {
            text-align: center;
            padding: 40px;
            color: var(--text-secondary);
            font-size: 1.1rem;
        }

        .last-updated {
            text-align: right;
            color: var(--text-secondary);
            font-size: 0.85rem;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        <h1>ICS SRE vCenter Dashboard</h1>
        <p>VM Search & Resource Analytics</p>
    </div>

    <div class="container-fluid">
        <!-- Analytics Cards -->
        <div class="analytics-grid">
            <div class="card-metric blue">
                <div class="metric-label">Total VMs</div>
                <div class="metric-value" id="totalVMs">0</div>
                <div class="metric-subtitle"><span id="onlineCount">0</span> Online</div>
            </div>
            <div class="card-metric cyan">
                <div class="metric-label">vCenters</div>
                <div class="metric-value" id="totalVCenters">0</div>
                <div class="metric-subtitle">Active Sites</div>
            </div>
            <div class="card-metric green">
                <div class="metric-label">Powered On</div>
                <div class="metric-value" id="poweredOn">0</div>
                <div class="metric-subtitle"><span id="poweredOnPercent">0</span>% of total</div>
            </div>
            <div class="card-metric red">
                <div class="metric-label">Powered Off</div>
                <div class="metric-value" id="poweredOff">0</div>
                <div class="metric-subtitle"><span id="poweredOffStorage">0</span> TB used</div>
            </div>
            <div class="card-metric purple">
                <div class="metric-label">Storage Utilization</div>
                <div class="metric-value" id="storageUtilization">0%</div>
                <div class="metric-subtitle"><span id="storageDetails">0 TB of 0 TB</span></div>
            </div>
            <div class="card-metric orange">
                <div class="metric-label">Memory Allocation</div>
                <div class="metric-value" id="memoryAllocation">0%</div>
                <div class="metric-subtitle"><span id="memoryDetails">0 GB of 0 GB</span></div>
            </div>
        </div>

        <div class="last-updated">Last updated: <span id="lastUpdated">Never</span> • Auto-refreshes hourly</div>

        <!-- Alert -->
        <div id="alert" class="alert"></div>

        <!-- Search Single VM -->
        <div class="section-title">🔍 Search Single VM</div>
        <div class="search-panel">
            <div class="search-input-group">
                <input type="text" id="singleVMSearch" placeholder="Search by VM name (supports wildcards: edp*, *qa*, etc.)" />
                <button class="btn-search" onclick="searchSingleVM()">Search</button>
            </div>
            <div id="singleVMResults"></div>
        </div>

        <!-- Search by vCenter -->
        <div class="section-title">🏢 Search by vCenter</div>
        <div class="search-panel">
            <div class="search-input-group">
                <select id="vCenterSelect" onchange="onVCenterSelected()">
                    <option value="">Select a vCenter...</option>
                </select>
                <button class="btn-search" onclick="searchByVCenter()">Search</button>
            </div>

            <!-- Advanced Filters (Dynamic - shows only after vCenter selected) -->
            <div class="advanced-filters" id="advancedFilters">
                <h5 style="margin-bottom: 20px;">Advanced Filtering (Optional)</h5>
                <div class="filter-grid">
                    <div class="filter-group">
                        <label>Power State</label>
                        <select id="powerStateFilter">
                            <option value="">All States</option>
                            <option value="on">Powered On</option>
                            <option value="off">Powered Off</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Guest OS</label>
                        <select id="guestOsFilter">
                            <option value="">All OS</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Memory (GB)</label>
                        <select id="memoryFilter">
                            <option value="">All Sizes</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>CPU Cores</label>
                        <select id="cpuFilter">
                            <option value="">All Counts</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Tools Status</label>
                        <select id="toolsStatusFilter">
                            <option value="">All Statuses</option>
                            <option value="running">Running</option>
                            <option value="notRunning">Not Running</option>
                        </select>
                    </div>
                </div>
                <div class="filter-buttons">
                    <button class="btn-search" onclick="applyAdvancedFilters()">Apply Filters</button>
                    <button class="btn-clear" onclick="clearAdvancedFilters()">Clear Filters</button>
                </div>
            </div>

            <div id="vCenterResults"></div>
        </div>

        <!-- Search Multiple VMs -->
        <div class="section-title">📋 Search Multiple VMs</div>
        <div class="search-panel">
            <div class="search-input-group" style="flex-direction: column;">
                <textarea id="multipleVMSearch" placeholder="Enter VM names/patterns (one per line). Examples: edp*, *qa*, prod-db-*" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); padding: 12px; border-radius: 8px; height: 100px; resize: vertical; font-family: monospace;"></textarea>
                <div style="display: flex; gap: 10px; margin-top: 10px;">
                    <button class="btn-search" onclick="searchMultipleVMs()" style="flex: 1;">Search</button>
                    <button class="btn-clear" onclick="clearMultipleVMs()" style="flex: 1;">Clear</button>
                </div>
            </div>
            <div id="multipleVMResults"></div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Initialize
        document.addEventListener('DOMContentLoaded', function () {
            loadDashboardData();
        });

        let allVMs = [];
        let filteredVMs = [];

        // Load Dashboard Summary
        function loadDashboardData() {
            fetch('/api/dashboard-summary')
                .then(response => {
                    if (!response.ok) throw new Error('Failed to load dashboard data');
                    return response.json();
                })
                .then(data => {
                    document.getElementById('totalVMs').textContent = data.totalVMs.toLocaleString();
                    document.getElementById('totalVCenters').textContent = data.totalVCenters;
                    document.getElementById('poweredOn').textContent = data.poweredOnCount.toLocaleString();
                    document.getElementById('poweredOnPercent').textContent = data.poweredOnPercent.toFixed(1);
                    document.getElementById('poweredOff').textContent = data.poweredOffCount.toLocaleString();
                    document.getElementById('poweredOffStorage').textContent = (data.poweredOffStorage / 1024 / 1024).toFixed(1);
                    document.getElementById('storageUtilization').textContent = data.storageUtilization.toFixed(1) + '%';
                    document.getElementById('storageDetails').textContent = (data.usedStorage / 1024 / 1024).toFixed(1) + ' TB of ' + (data.totalStorage / 1024 / 1024).toFixed(1) + ' TB';
                    document.getElementById('memoryAllocation').textContent = data.memoryAllocation.toFixed(1) + '%';
                    document.getElementById('memoryDetails').textContent = (data.allocatedMemory / 1024).toFixed(1) + ' GB of ' + (data.totalMemory / 1024).toFixed(1) + ' GB';
                    document.getElementById('onlineCount').textContent = data.onlineCount;
                    document.getElementById('lastUpdated').textContent = new Date().toLocaleString();

                    // Populate vCenter dropdown
                    const vCenters = [...new Set(data.vCenters)];
                    const select = document.getElementById('vCenterSelect');
                    vCenters.forEach(vc => {
                        const option = document.createElement('option');
                        option.value = vc;
                        option.textContent = vc;
                        select.appendChild(option);
                    });

                    allVMs = data.allVMs;
                })
                .catch(error => {
                    showAlert('Error loading dashboard data: ' + error.message, 'error');
                    console.error(error);
                });
        }

        // Single VM Search
        function searchSingleVM() {
            const searchTerm = document.getElementById('singleVMSearch').value.trim();
            if (!searchTerm) {
                showAlert('Please enter a VM name to search', 'error');
                return;
            }

            fetch(`/api/search-single-vm?searchTerm=${encodeURIComponent(searchTerm)}`)
                .then(response => response.json())
                .then(data => {
                    displayResults(data.vms, 'singleVMResults');
                })
                .catch(error => {
                    showAlert('Error searching VMs: ' + error.message, 'error');
                });
        }

        // vCenter Selected
        function onVCenterSelected() {
            const vCenter = document.getElementById('vCenterSelect').value;
            if (vCenter) {
                document.getElementById('advancedFilters').classList.add('show');
            } else {
                document.getElementById('advancedFilters').classList.remove('show');
            }
        }

        // Search by vCenter
        function searchByVCenter() {
            const vCenter = document.getElementById('vCenterSelect').value;
            if (!vCenter) {
                showAlert('Please select a vCenter', 'error');
                return;
            }

            fetch(`/api/search-vcenter?vCenter=${encodeURIComponent(vCenter)}`)
                .then(response => response.json())
                .then(data => {
                    displayResults(data.vms, 'vCenterResults');
                })
                .catch(error => {
                    showAlert('Error searching by vCenter: ' + error.message, 'error');
                });
        }

        // Apply Advanced Filters
        function applyAdvancedFilters() {
            const vCenter = document.getElementById('vCenterSelect').value;
            const powerState = document.getElementById('powerStateFilter').value;
            const guestOs = document.getElementById('guestOsFilter').value;
            const memory = document.getElementById('memoryFilter').value;
            const cpu = document.getElementById('cpuFilter').value;
            const toolsStatus = document.getElementById('toolsStatusFilter').value;

            const params = new URLSearchParams({
                vCenter: vCenter,
                powerState: powerState,
                guestOs: guestOs,
                memory: memory,
                cpu: cpu,
                toolsStatus: toolsStatus
            });

            fetch(`/api/advanced-filter?${params}`)
                .then(response => response.json())
                .then(data => {
                    displayResults(data.vms, 'vCenterResults');
                })
                .catch(error => {
                    showAlert('Error applying filters: ' + error.message, 'error');
                });
        }

        // Clear Advanced Filters
        function clearAdvancedFilters() {
            document.getElementById('powerStateFilter').value = '';
            document.getElementById('guestOsFilter').value = '';
            document.getElementById('memoryFilter').value = '';
            document.getElementById('cpuFilter').value = '';
            document.getElementById('toolsStatusFilter').value = '';
            document.getElementById('vCenterResults').innerHTML = '';
        }

        // Search Multiple VMs
        function searchMultipleVMs() {
            const searchTerms = document.getElementById('multipleVMSearch').value.trim().split('\n').filter(t => t.trim());
            if (searchTerms.length === 0) {
                showAlert('Please enter at least one VM name', 'error');
                return;
            }

            fetch('/api/search-multiple-vms', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ searchTerms: searchTerms })
            })
                .then(response => response.json())
                .then(data => {
                    displayResults(data.vms, 'multipleVMResults');
                })
                .catch(error => {
                    showAlert('Error searching multiple VMs: ' + error.message, 'error');
                });
        }

        // Clear Multiple VMs
        function clearMultipleVMs() {
            document.getElementById('multipleVMSearch').value = '';
            document.getElementById('multipleVMResults').innerHTML = '';
        }

        // Display Results
        function displayResults(vms, containerId) {
            const container = document.getElementById(containerId);
            if (!vms || vms.length === 0) {
                container.innerHTML = '<div class="no-results">No results found</div>';
                return;
            }

            let html = '<button class="btn-export" onclick="exportToCSV()">Export to CSV</button>';
            html += '<table class="results-table"><thead><tr>';
            html += '<th>VM Name</th><th>Power State</th><th>Hostname</th><th>vCenter</th><th>CPU</th><th>Memory GB</th>';
            html += '<th>Provisioned GB</th><th>Used GB</th><th>ESXi Host</th><th>Cluster</th><th>IP Address</th><th>Tools Status</th>';
            html += '</tr></thead><tbody>';

            vms.forEach(vm => {
                const powerClass = vm.powerState === 'on' ? 'on' : 'off';
                html += `<tr>
                    <td>${vm.vmName || '-'}</td>
                    <td><span class="power-state ${powerClass}">${vm.powerState || '-'}</span></td>
                    <td>${vm.hostname || '-'}</td>
                    <td>${vm.vCenter || '-'}</td>
                    <td>${vm.cpuCores || '-'}</td>
                    <td>${vm.memoryGb || '-'}</td>
                    <td>${vm.provisionedGb || '-'}</td>
                    <td>${vm.usedGb || '-'}</td>
                    <td>${vm.esxiHost || '-'}</td>
                    <td>${vm.cluster || '-'}</td>
                    <td>${vm.ipAddress || '-'}</td>
                    <td>${vm.toolsStatus || '-'}</td>
                </tr>`;
            });

            html += '</tbody></table>';
            container.innerHTML = html;
            showAlert(`Found ${vms.length} VM(s)`, 'success');
        }

        // Export to CSV
        function exportToCSV() {
            const table = document.querySelector('.results-table');
            if (!table) {
                showAlert('No results to export', 'error');
                return;
            }

            let csv = [];
            table.querySelectorAll('th').forEach(th => csv.push(th.textContent));
            csv = [csv];

            table.querySelectorAll('tbody tr').forEach(tr => {
                const row = [];
                tr.querySelectorAll('td').forEach(td => row.push(td.textContent));
                csv.push(row);
            });

            const csvContent = csv.map(row => row.map(cell => `"${cell}"`).join(',')).join('\n');
            const blob = new Blob([csvContent], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `vm-search-results-${new Date().toISOString().slice(0, 10)}.csv`;
            a.click();
            window.URL.revokeObjectURL(url);
        }

        // Show Alert
        function showAlert(message, type) {
            const alert = document.getElementById('alert');
            alert.textContent = message;
            alert.className = `alert ${type} show`;
            setTimeout(() => alert.classList.remove('show'), 4000);
        }
    </script>
</body>
</html>
