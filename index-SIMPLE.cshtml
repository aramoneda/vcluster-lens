@{
    ViewData["Title"] = "ICS SRE vCenter Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ICS SRE vCenter Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
                'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
                sans-serif;
            background-color: #0f172a;
            color: #e2e8f0;
        }

        .header {
            background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);
            padding: 40px 20px;
            text-align: center;
            border-bottom: 1px solid #1e293b;
        }

        .header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .header p {
            font-size: 1.1rem;
            color: #94a3b8;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        .analytics {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 12px;
            padding: 24px;
            border-left: 4px solid #3b82f6;
        }

        .card.blue { border-left-color: #3b82f6; }
        .card.green { border-left-color: #10b981; }
        .card.red { border-left-color: #ef4444; }
        .card.purple { border-left-color: #a855f7; }
        .card.orange { border-left-color: #f97316; }

        .card-label {
            font-size: 0.875rem;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 12px;
        }

        .card-value {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .card-detail {
            font-size: 0.875rem;
            color: #94a3b8;
        }

        .search-section {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 20px;
        }

        .search-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .search-form {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
            flex-wrap: wrap;
            align-items: flex-end;
        }

        .form-group {
            flex: 1;
            min-width: 200px;
        }

        .form-group label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 6px;
            color: #cbd5e1;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 10px 12px;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 6px;
            color: #e2e8f0;
            font-size: 0.95rem;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #3b82f6;
            background: #1e293b;
        }

        .btn {
            padding: 10px 24px;
            background: #3b82f6;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn:hover {
            background: #2563eb;
        }

        .btn-secondary {
            background: #475569;
        }

        .btn-secondary:hover {
            background: #334155;
        }

        .advanced-filters {
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 8px;
            padding: 16px;
            margin-top: 16px;
            display: none;
        }

        .advanced-filters.show {
            display: block;
        }

        .filter-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
        }

        .results {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 12px;
            overflow: hidden;
            margin-top: 16px;
            display: none;
        }

        .results.show {
            display: block;
        }

        .results-header {
            background: #0f172a;
            padding: 16px 24px;
            border-bottom: 1px solid #334155;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .results-count {
            font-size: 0.95rem;
            color: #94a3b8;
        }

        .btn-export {
            background: #10b981;
            padding: 8px 16px;
            font-size: 0.875rem;
        }

        .btn-export:hover {
            background: #059669;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #0f172a;
            padding: 12px 24px;
            text-align: left;
            font-size: 0.875rem;
            font-weight: 600;
            color: #cbd5e1;
            border-bottom: 1px solid #334155;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        td {
            padding: 12px 24px;
            border-bottom: 1px solid #1e293b;
            font-size: 0.875rem;
        }

        tr:hover {
            background: #1e293b;
        }

        .power-on {
            color: #10b981;
        }

        .power-off {
            color: #ef4444;
        }

        .alert {
            padding: 12px 16px;
            background: #7f1d1d;
            border: 1px solid #dc2626;
            border-radius: 6px;
            color: #fecaca;
            margin-bottom: 16px;
            display: none;
        }

        .alert.show {
            display: block;
        }

        .last-updated {
            text-align: right;
            font-size: 0.875rem;
            color: #64748b;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>ICS SRE vCenter Dashboard</h1>
        <p>VM Search & Resource Analytics</p>
    </div>

    <div class="container">
        <!-- Analytics Cards -->
        <div class="analytics">
            <div class="card blue">
                <div class="card-label">Total VMs</div>
                <div class="card-value" id="totalVms">0</div>
                <div class="card-detail"><span id="onlineVms">0</span> Online</div>
            </div>
            <div class="card blue">
                <div class="card-label">vCenters</div>
                <div class="card-value" id="vcenters">0</div>
                <div class="card-detail">Active Sites</div>
            </div>
            <div class="card green">
                <div class="card-label">Powered On</div>
                <div class="card-value" id="poweredOn">0</div>
                <div class="card-detail"><span id="poweredOnPercent">0</span>% of total</div>
            </div>
            <div class="card red">
                <div class="card-label">Powered Off</div>
                <div class="card-value" id="poweredOff">0</div>
                <div class="card-detail"><span id="poweredOffTb">0</span> TB used</div>
            </div>
            <div class="card purple">
                <div class="card-label">Storage Utilization</div>
                <div class="card-value" id="storageUtil">0%</div>
                <div class="card-detail"><span id="storageUsedTb">0</span> TB of <span id="storageProvTb">0</span> TB</div>
            </div>
            <div class="card orange">
                <div class="card-label">Memory Allocation</div>
                <div class="card-value" id="memoryAlloc">0%</div>
                <div class="card-detail"><span id="memoryGb">0</span> GB of 0 GB</div>
            </div>
        </div>

        <!-- Single VM Search -->
        <div class="search-section">
            <div class="search-title">🔍 Search Single VM</div>
            <div class="alert" id="alert1"></div>
            <div class="search-form">
                <div class="form-group" style="flex: 1; min-width: 300px;">
                    <input type="text" id="singleVmInput" placeholder="Search by VM name (supports wildcards: edp*, *qa*, etc.)" />
                </div>
                <button class="btn" onclick="searchSingleVm()">Search</button>
                <button class="btn btn-secondary" onclick="clearResults('single')">Clear</button>
            </div>
            <div class="results" id="resultsSection1">
                <div class="results-header">
                    <span class="results-count">Found <span id="count1">0</span> results</span>
                    <button class="btn btn-export" onclick="exportCsv(1)">Export to CSV</button>
                </div>
                <div class="table-wrapper">
                    <table id="resultsTable1"></table>
                </div>
            </div>
        </div>

        <!-- vCenter Search -->
        <div class="search-section">
            <div class="search-title">🏢 Search by vCenter</div>
            <div class="alert" id="alert2"></div>
            <div class="search-form">
                <div class="form-group">
                    <label>Select vCenter</label>
                    <select id="vcenterSelect" onchange="onVCenterSelected()"></select>
                </div>
                <button class="btn" onclick="searchVCenter()" style="align-self: flex-end;">Search</button>
                <button class="btn btn-secondary" onclick="clearResults('vcenter')" style="align-self: flex-end;">Clear</button>
            </div>

            <!-- Advanced Filtering -->
            <div class="advanced-filters" id="advancedFilters">
                <div style="margin-bottom: 16px; font-size: 0.875rem; font-weight: 600; color: #cbd5e1;">
                    ADVANCED FILTERING (OPTIONAL)
                </div>
                <div class="filter-grid">
                    <div class="form-group">
                        <label>Power State</label>
                        <select id="filterPowerState">
                            <option>All</option>
                            <option>poweredon</option>
                            <option>poweredoff</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Guest OS</label>
                        <select id="filterGuestOs"></select>
                    </div>
                    <div class="form-group">
                        <label>Memory (GB)</label>
                        <select id="filterMemory">
                            <option>All Sizes</option>
                            <option>0-4GB</option>
                            <option>4-8GB</option>
                            <option>8-16GB</option>
                            <option>16-32GB</option>
                            <option>32GB+</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>CPU Cores</label>
                        <select id="filterCpu">
                            <option>All Counts</option>
                            <option>1-2</option>
                            <option>2-4</option>
                            <option>4-8</option>
                            <option>8+</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Tools Status</label>
                        <select id="filterToolsStatus">
                            <option>All</option>
                            <option>toolsNotInstalled</option>
                            <option>toolsOk</option>
                            <option>toolsOld</option>
                        </select>
                    </div>
                    <div style="display: flex; gap: 8px; align-items: flex-end;">
                        <button class="btn" onclick="applyAdvancedFilters()" style="flex: 1;">Apply Filters</button>
                    </div>
                </div>
            </div>

            <div class="results" id="resultsSection2">
                <div class="results-header">
                    <span class="results-count">Found <span id="count2">0</span> results</span>
                    <button class="btn btn-export" onclick="exportCsv(2)">Export to CSV</button>
                </div>
                <div class="table-wrapper">
                    <table id="resultsTable2"></table>
                </div>
            </div>
        </div>

        <!-- Multiple VMs Search -->
        <div class="search-section">
            <div class="search-title">📋 Search Multiple VMs</div>
            <div class="alert" id="alert3"></div>
            <div class="search-form">
                <div class="form-group" style="flex: 1; min-width: 300px;">
                    <input type="text" id="multipleVmsInput" placeholder="Enter VM names separated by commas (supports wildcards)" />
                </div>
                <button class="btn" onclick="searchMultipleVms()">Search</button>
                <button class="btn btn-secondary" onclick="clearResults('multiple')">Clear</button>
            </div>
            <div class="results" id="resultsSection3">
                <div class="results-header">
                    <span class="results-count">Found <span id="count3">0</span> results</span>
                    <button class="btn btn-export" onclick="exportCsv(3)">Export to CSV</button>
                </div>
                <div class="table-wrapper">
                    <table id="resultsTable3"></table>
                </div>
            </div>
        </div>

        <div class="last-updated">
            Last updated: <span id="lastUpdated">Never</span> · Auto-refreshes hourly
        </div>
    </div>

    <script>
        let currentVCenterData = [];
        let allGuestOses = [];

        // Load dashboard on page load
        document.addEventListener('DOMContentLoaded', async () => {
            await loadDashboard();
            populateVCenterSelect();
            updateLastUpdated();
        });

        async function loadDashboard() {
            try {
                const response = await fetch('/api/dashboard-summary');
                const data = await response.json();

                document.getElementById('totalVms').textContent = data.totalVms;
                document.getElementById('vcenters').textContent = data.vcenters;
                document.getElementById('poweredOn').textContent = data.poweredOn;
                document.getElementById('poweredOff').textContent = data.poweredOff;
                document.getElementById('poweredOnPercent').textContent = data.totalVms > 0 ? Math.round((data.poweredOn / data.totalVms) * 100) : 0;
                document.getElementById('onlineVms').textContent = data.poweredOn;
                document.getElementById('poweredOffTb').textContent = data.storageUsed.toFixed(1);
                document.getElementById('storageUtil').textContent = Math.round(data.storageUtilization) + '%';
                document.getElementById('storageUsedTb').textContent = data.storageUsed.toFixed(1);
                document.getElementById('storageProvTb').textContent = data.storageProvisioned.toFixed(1);
                document.getElementById('memoryAlloc').textContent = data.memoryAllocation.toFixed(0) + ' GB';
                document.getElementById('memoryGb').textContent = data.memoryAllocation.toFixed(0);
            } catch (error) {
                console.error('Error loading dashboard:', error);
                showAlert(1, 'Error loading dashboard data: ' + error.message);
            }
        }

        async function populateVCenterSelect() {
            try {
                // Get all data and extract unique vCenters
                const response = await fetch('/api/dashboard-summary');
                const summary = await response.json();
                
                const select = document.getElementById('vcenterSelect');
                const option = document.createElement('option');
                option.value = '';
                option.textContent = 'Select a vCenter...';
                select.appendChild(option);
                
                // This would normally get vcenters from a dedicated endpoint
                // For now, we'll add them on first search
            } catch (error) {
                console.error('Error populating vCenter select:', error);
            }
        }

        function onVCenterSelected() {
            const vcenter = document.getElementById('vcenterSelect').value;
            const filters = document.getElementById('advancedFilters');
            
            if (vcenter) {
                filters.classList.add('show');
            } else {
                filters.classList.remove('show');
            }
        }

        async function searchSingleVm() {
            const pattern = document.getElementById('singleVmInput').value.trim();
            if (!pattern) {
                showAlert(1, 'Please enter a VM name pattern');
                return;
            }

            try {
                const response = await fetch('/api/search-single-vm', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ pattern })
                });

                const data = await response.json();
                displayResults(data.results, 1);
            } catch (error) {
                console.error('Error searching VMs:', error);
                showAlert(1, 'Error searching for VMs: ' + error.message);
            }
        }

        async function searchVCenter() {
            const vcenter = document.getElementById('vcenterSelect').value;
            if (!vcenter) {
                showAlert(2, 'Please select a vCenter');
                return;
            }

            try {
                const response = await fetch('/api/search-vcenter', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ vcenter })
                });

                const data = await response.json();
                currentVCenterData = data.results;
                displayResults(data.results, 2);
                populateAdvancedFilters(data.results);
            } catch (error) {
                console.error('Error searching vCenter:', error);
                showAlert(2, 'Error searching vCenter: ' + error.message);
            }
        }

        async function applyAdvancedFilters() {
            const vcenter = document.getElementById('vcenterSelect').value;
            const powerState = document.getElementById('filterPowerState').value;
            const guestOs = document.getElementById('filterGuestOs').value;
            const memoryRange = document.getElementById('filterMemory').value;
            const cpuRange = document.getElementById('filterCpu').value;
            const toolsStatus = document.getElementById('filterToolsStatus').value;

            try {
                const response = await fetch('/api/advanced-filter', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ vcenter, powerState, guestOs, memoryRange, cpuRange, toolsStatus })
                });

                const data = await response.json();
                displayResults(data.results, 2);
            } catch (error) {
                console.error('Error applying filters:', error);
                showAlert(2, 'Error applying filters: ' + error.message);
            }
        }

        async function searchMultipleVms() {
            const patterns = document.getElementById('multipleVmsInput').value.trim();
            if (!patterns) {
                showAlert(3, 'Please enter VM name patterns');
                return;
            }

            try {
                const response = await fetch('/api/search-multiple-vms', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ patterns })
                });

                const data = await response.json();
                displayResults(data.results, 3);
            } catch (error) {
                console.error('Error searching multiple VMs:', error);
                showAlert(3, 'Error searching VMs: ' + error.message);
            }
        }

        function displayResults(results, sectionNum) {
            const count = document.getElementById('count' + sectionNum);
            const table = document.getElementById('resultsTable' + sectionNum);
            const section = document.getElementById('resultsSection' + sectionNum);

            count.textContent = results.length;

            if (results.length === 0) {
                table.innerHTML = '<tr><td colspan="12" style="text-align: center; padding: 20px;">No results found</td></tr>';
                section.classList.remove('show');
                return;
            }

            let html = `
                <tr>
                    <th>VM NAME</th>
                    <th>POWER STATE</th>
                    <th>HOSTNAME</th>
                    <th>vCENTER</th>
                    <th>CPU</th>
                    <th>MEMORY GB</th>
                    <th>PROVISIONED GB</th>
                    <th>USED GB</th>
                    <th>ESXI HOST</th>
                    <th>CLUSTER</th>
                    <th>IP ADDRESS</th>
                    <th>TOOLS STATUS</th>
                </tr>
            `;

            results.forEach(vm => {
                const powerClass = vm.powerState?.toLowerCase() === 'poweredon' ? 'power-on' : 'power-off';
                html += `
                    <tr>
                        <td>${vm.vmName || '-'}</td>
                        <td class="${powerClass}">${vm.powerState || '-'}</td>
                        <td>${vm.guestHostname || '-'}</td>
                        <td>${vm.vcenter || '-'}</td>
                        <td>${vm.numCpu || '-'}</td>
                        <td>${vm.memoryGb || '-'}</td>
                        <td>${vm.provisionedGb || '-'}</td>
                        <td>${vm.usedGb || '-'}</td>
                        <td>${vm.esxiHost || '-'}</td>
                        <td>${vm.cluster || '-'}</td>
                        <td>${vm.ipAddress || '-'}</td>
                        <td>${vm.toolsStatus || '-'}</td>
                    </tr>
                `;
            });

            table.innerHTML = html;
            section.classList.add('show');
        }

        function populateAdvancedFilters(results) {
            const guestOses = [...new Set(results.map(r => r.guestOs).filter(Boolean))];
            const select = document.getElementById('filterGuestOs');
            select.innerHTML = '<option>All</option>';
            guestOses.forEach(os => {
                const option = document.createElement('option');
                option.value = os;
                option.textContent = os;
                select.appendChild(option);
            });
        }

        function exportCsv(sectionNum) {
            const table = document.getElementById('resultsTable' + sectionNum);
            const rows = table.querySelectorAll('tr');
            if (rows.length <= 1) {
                alert('No data to export');
                return;
            }

            let csv = [];
            rows.forEach(row => {
                const cols = row.querySelectorAll('td, th');
                csv.push(Array.from(cols).map(col => `"${col.textContent}"`).join(','));
            });

            const csvContent = csv.join('\n');
            const link = document.createElement('a');
            link.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csvContent);
            link.download = `vm-export-${new Date().toISOString().slice(0, 10)}.csv`;
            link.click();
        }

        function clearResults(type) {
            if (type === 'single') {
                document.getElementById('singleVmInput').value = '';
                document.getElementById('resultsSection1').classList.remove('show');
            } else if (type === 'vcenter') {
                document.getElementById('vcenterSelect').value = '';
                document.getElementById('advancedFilters').classList.remove('show');
                document.getElementById('resultsSection2').classList.remove('show');
            } else if (type === 'multiple') {
                document.getElementById('multipleVmsInput').value = '';
                document.getElementById('resultsSection3').classList.remove('show');
            }
        }

        function showAlert(sectionNum, message) {
            const alert = document.getElementById('alert' + sectionNum);
            alert.textContent = message;
            alert.classList.add('show');
            setTimeout(() => alert.classList.remove('show'), 5000);
        }

        function updateLastUpdated() {
            const now = new Date();
            document.getElementById('lastUpdated').textContent = now.toLocaleTimeString();
        }
    </script>
</body>
</html>
