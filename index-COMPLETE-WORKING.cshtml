@{
    ViewData["Title"] = "ICS SRE vCenter Dashboard";
    var vcenters = ViewBag.VCenters as List<string> ?? new List<string>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #0f172a;
            color: #e2e8f0;
        }

        .header {
            background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);
            padding: 3rem 2rem;
            text-align: center;
            border-bottom: 1px solid #1e293b;
        }

        .header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 0.5rem;
        }

        .header p {
            font-size: 1.1rem;
            color: #94a3b8;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        .analytics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .analytics-card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 0.75rem;
            padding: 1.5rem;
            border-left: 4px solid #3b82f6;
        }

        .analytics-card:nth-child(2) {
            border-left-color: #3b82f6;
        }

        .analytics-card:nth-child(3) {
            border-left-color: #10b981;
        }

        .analytics-card:nth-child(4) {
            border-left-color: #ef4444;
        }

        .analytics-card:nth-child(5) {
            border-left-color: #a855f7;
        }

        .analytics-card:nth-child(6) {
            border-left-color: #f59e0b;
        }

        .analytics-label {
            font-size: 0.875rem;
            color: #94a3b8;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        .analytics-value {
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 0.5rem;
        }

        .analytics-detail {
            font-size: 0.875rem;
            color: #94a3b8;
        }

        .search-section {
            margin-bottom: 2rem;
        }

        .search-panel {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 0.75rem;
            padding: 2rem;
            margin-bottom: 1.5rem;
        }

        .search-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .search-title:before {
            content: "🔍";
            font-size: 1.1rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #cbd5e1;
        }

        .form-control {
            width: 100%;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 0.5rem;
            padding: 0.75rem;
            color: #e2e8f0;
            font-size: 0.95rem;
        }

        .form-control:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .btn {
            background: #3b82f6;
            color: white;
            border: none;
            border-radius: 0.5rem;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.95rem;
        }

        .btn:hover {
            background: #2563eb;
            transform: translateY(-2px);
        }

        .btn-secondary {
            background: #64748b;
        }

        .btn-secondary:hover {
            background: #475569;
        }

        .btn-success {
            background: #10b981;
        }

        .btn-success:hover {
            background: #059669;
        }

        .advanced-filters {
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 0.5rem;
            padding: 1.5rem;
            margin-top: 1.5rem;
            display: none;
        }

        .advanced-filters.show {
            display: block;
        }

        .advanced-title {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: #cbd5e1;
        }

        .filter-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .results-container {
            margin-top: 2rem;
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 0.75rem;
            overflow: hidden;
        }

        .results-header {
            background: #0f172a;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #334155;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .results-title {
            font-weight: 600;
            color: #e2e8f0;
        }

        .results-count {
            font-size: 0.875rem;
            color: #94a3b8;
        }

        .results-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
        }

        .results-table thead {
            background: #0f172a;
        }

        .results-table th {
            padding: 0.75rem 1rem;
            text-align: left;
            font-weight: 600;
            color: #94a3b8;
            border-bottom: 1px solid #334155;
            white-space: nowrap;
        }

        .results-table td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #334155;
            color: #cbd5e1;
        }

        .results-table tbody tr:hover {
            background: #334155;
        }

        .status-powered-on {
            color: #10b981;
            font-weight: 600;
        }

        .status-powered-off {
            color: #ef4444;
            font-weight: 600;
        }

        .error-alert {
            background: #7f1d1d;
            border: 1px solid #991b1b;
            color: #fecaca;
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
        }

        .success-alert {
            background: #065f46;
            border: 1px solid #047857;
            color: #a7f3d0;
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
        }

        .loading {
            text-align: center;
            padding: 2rem;
            color: #94a3b8;
        }

        .spinner {
            display: inline-block;
            width: 1rem;
            height: 1rem;
            border: 2px solid #3b82f6;
            border-top-color: transparent;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        .last-updated {
            text-align: center;
            color: #94a3b8;
            font-size: 0.875rem;
            padding: 1rem;
            margin-top: 2rem;
        }

        @@media (max-width: 768px) {
            .analytics-grid {
                grid-template-columns: 1fr;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .header h1 {
                font-size: 1.75rem;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>ICS SRE vCenter Dashboard</h1>
        <p>VM Search & Resource Analytics</p>
    </div>

    <div class="container">
        <!-- Analytics Cards -->
        <div class="analytics-grid">
            <div class="analytics-card">
                <div class="analytics-label">Total VMs</div>
                <div class="analytics-value" id="totalVms">0</div>
                <div class="analytics-detail" id="totalVmsDetail">0 Online</div>
            </div>
            <div class="analytics-card">
                <div class="analytics-label">vCenters</div>
                <div class="analytics-value" id="vcentersCount">0</div>
                <div class="analytics-detail">Active Sites</div>
            </div>
            <div class="analytics-card">
                <div class="analytics-label">Powered On</div>
                <div class="analytics-value" id="poweredOn">0</div>
                <div class="analytics-detail"><span id="poweredOnPercent">0</span>% of total</div>
            </div>
            <div class="analytics-card">
                <div class="analytics-label">Powered Off</div>
                <div class="analytics-value" id="poweredOff">0</div>
                <div class="analytics-detail"><span id="poweredOffTb">0</span> TB used</div>
            </div>
            <div class="analytics-card">
                <div class="analytics-label">Storage Utilization</div>
                <div class="analytics-value" id="storagePercent">0%</div>
                <div class="analytics-detail"><span id="storageUsed">0</span> TB of <span id="storageTotal">0</span> TB</div>
            </div>
            <div class="analytics-card">
                <div class="analytics-label">Memory Allocation</div>
                <div class="analytics-value" id="memoryPercent">0%</div>
                <div class="analytics-detail"><span id="memoryUsed">0</span> GB of <span id="memoryTotal">0</span> GB</div>
            </div>
        </div>

        <!-- Single VM Search -->
        <div class="search-panel">
            <div class="search-title">Search Single VM</div>
            <div id="singleVmError" class="error-alert" style="display:none;"></div>
            <div class="form-group">
                <input type="text" id="singleVmSearch" class="form-control" placeholder="Search by VM name (supports wildcards: edp*, *qa*, etc.)" />
            </div>
            <button class="btn" onclick="searchSingleVm()">Search</button>
            <div id="singleVmResults" class="results-container" style="display:none;">
                <div class="results-header">
                    <span class="results-title">Search Results: <span class="results-count" id="singleVmCount">0</span> VMs found</span>
                    <button class="btn btn-success" onclick="exportResults('singleVm')">Export to CSV</button>
                </div>
                <table class="results-table">
                    <thead>
                        <tr>
                            <th>VM Name</th>
                            <th>Power State</th>
                            <th>Hostname</th>
                            <th>vCenter</th>
                            <th>CPU</th>
                            <th>Memory GB</th>
                            <th>Provisioned GB</th>
                            <th>Used GB</th>
                            <th>ESXi Host</th>
                            <th>Cluster</th>
                            <th>IP Address</th>
                            <th>Tools Status</th>
                        </tr>
                    </thead>
                    <tbody id="singleVmTableBody">
                    </tbody>
                </table>
            </div>
        </div>

        <!-- vCenter Search -->
        <div class="search-panel">
            <div class="search-title">Search by vCenter</div>
            <div id="vCenterError" class="error-alert" style="display:none;"></div>
            <div class="form-group">
                <label class="form-label">Select vCenter</label>
                <select id="vCenterSelect" class="form-control" onchange="onVCenterSelected()">
                    <option value="">-- Select vCenter --</option>
                    @foreach (var vc in vcenters)
                    {
                        <option value="@vc">@vc</option>
                    }
                </select>
            </div>

            <!-- Advanced Filtering -->
            <div id="advancedFiltersContainer" class="advanced-filters">
                <div class="advanced-title">Advanced Filtering (Optional)</div>
                <div class="filter-grid">
                    <div class="form-group">
                        <label class="form-label">Power State</label>
                        <select id="filterPowerState" class="form-control">
                            <option value="All">All</option>
                            <option value="PoweredOn">Powered On</option>
                            <option value="PoweredOff">Powered Off</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Guest OS</label>
                        <select id="filterGuestOs" class="form-control">
                            <option value="All OSes">All OSes</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Memory (GB) Min</label>
                        <input type="number" id="filterMemoryMin" class="form-control" placeholder="0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Memory (GB) Max</label>
                        <input type="number" id="filterMemoryMax" class="form-control" placeholder="1024" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">CPU Cores Min</label>
                        <input type="number" id="filterCpuMin" class="form-control" placeholder="0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">CPU Cores Max</label>
                        <input type="number" id="filterCpuMax" class="form-control" placeholder="128" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Tools Status</label>
                    <select id="filterToolsStatus" class="form-control">
                        <option value="All Status">All Status</option>
                        <option value="toolsOk">Tools OK</option>
                        <option value="toolsNotRunning">Tools Not Running</option>
                    </select>
                </div>
                <button class="btn" onclick="searchVCenter()">Apply Filters & Search</button>
                <button class="btn btn-secondary" onclick="clearFilters()">Clear Filters</button>
            </div>

            <button class="btn" onclick="searchVCenter()" id="vCenterSearchBtn" style="display:none;">Search</button>
            <div id="vCenterResults" class="results-container" style="display:none;">
                <div class="results-header">
                    <span class="results-title">Search Results: <span class="results-count" id="vCenterCount">0</span> VMs found</span>
                    <button class="btn btn-success" onclick="exportResults('vCenter')">Export to CSV</button>
                </div>
                <table class="results-table">
                    <thead>
                        <tr>
                            <th>VM Name</th>
                            <th>Power State</th>
                            <th>Hostname</th>
                            <th>vCenter</th>
                            <th>CPU</th>
                            <th>Memory GB</th>
                            <th>Provisioned GB</th>
                            <th>Used GB</th>
                            <th>ESXi Host</th>
                            <th>Cluster</th>
                            <th>IP Address</th>
                            <th>Tools Status</th>
                        </tr>
                    </thead>
                    <tbody id="vCenterTableBody">
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Multiple VM Search -->
        <div class="search-panel">
            <div class="search-title">Search Multiple VMs</div>
            <div id="multipleVmError" class="error-alert" style="display:none;"></div>
            <div class="form-group">
                <label class="form-label">Enter VM names (comma separated, supports wildcards)</label>
                <textarea id="multipleVmSearch" class="form-control" rows="3" placeholder="Example: edp*,qa*,prod-vm-01"></textarea>
            </div>
            <button class="btn" onclick="searchMultipleVMs()">Search</button>
            <div id="multipleVmResults" class="results-container" style="display:none;">
                <div class="results-header">
                    <span class="results-title">Search Results: <span class="results-count" id="multipleVmCount">0</span> VMs found</span>
                    <button class="btn btn-success" onclick="exportResults('multipleVm')">Export to CSV</button>
                </div>
                <table class="results-table">
                    <thead>
                        <tr>
                            <th>VM Name</th>
                            <th>Power State</th>
                            <th>Hostname</th>
                            <th>vCenter</th>
                            <th>CPU</th>
                            <th>Memory GB</th>
                            <th>Provisioned GB</th>
                            <th>Used GB</th>
                            <th>ESXi Host</th>
                            <th>Cluster</th>
                            <th>IP Address</th>
                            <th>Tools Status</th>
                        </tr>
                    </thead>
                    <tbody id="multipleVmTableBody">
                    </tbody>
                </table>
            </div>
        </div>

        <div class="last-updated">
            Last updated: <span id="lastUpdated">Never</span> • Auto-refreshes hourly
        </div>
    </div>

    <script>
        let currentResults = {};

        // Load dashboard summary on page load
        document.addEventListener('DOMContentLoaded', function () {
            loadDashboardSummary();
            setInterval(loadDashboardSummary, 3600000); // Refresh every hour
        });

        function loadDashboardSummary() {
            fetch('/api/dashboard-summary')
                .then(r => r.json())
                .then(data => {
                    if (data.error) {
                        console.error('Dashboard error:', data.error);
                        return;
                    }
                    document.getElementById('totalVms').textContent = data.totalVms?.toLocaleString() || '0';
                    document.getElementById('totalVmsDetail').textContent = (data.totalVms - data.poweredOff) + ' Online';
                    document.getElementById('vcentersCount').textContent = data.vcenters || '0';
                    document.getElementById('poweredOn').textContent = data.poweredOn?.toLocaleString() || '0';
                    document.getElementById('poweredOnPercent').textContent = data.poweredOnPercent || '0';
                    document.getElementById('poweredOff').textContent = data.poweredOff?.toLocaleString() || '0';
                    document.getElementById('poweredOffTb').textContent = (data.poweredOffTb || 0).toFixed(1);
                    document.getElementById('storagePercent').textContent = (data.storagePercent || 0).toFixed(1) + '%';
                    document.getElementById('storageUsed').textContent = (data.storageUsedTb || 0).toFixed(1);
                    document.getElementById('storageTotal').textContent = (data.storageTotalTb || 0).toFixed(1);
                    document.getElementById('memoryPercent').textContent = (data.memoryPercent || 0).toFixed(1) + '%';
                    document.getElementById('memoryUsed').textContent = (data.memoryUsedGb || 0).toFixed(1);
                    document.getElementById('memoryTotal').textContent = (data.memoryUsedGb || 0).toFixed(1);
                    document.getElementById('lastUpdated').textContent = data.lastUpdated || 'Never';
                })
                .catch(err => console.error('Error loading dashboard:', err));
        }

        function onVCenterSelected() {
            const vcenter = document.getElementById('vCenterSelect').value;
            if (vcenter) {
                document.getElementById('advancedFiltersContainer').classList.add('show');
                document.getElementById('vCenterSearchBtn').style.display = 'inline-block';
            } else {
                document.getElementById('advancedFiltersContainer').classList.remove('show');
                document.getElementById('vCenterSearchBtn').style.display = 'none';
                document.getElementById('vCenterResults').style.display = 'none';
            }
        }

        function searchSingleVm() {
            const searchTerm = document.getElementById('singleVmSearch').value.trim();
            if (!searchTerm) {
                showError('singleVmError', 'Please enter a VM name');
                return;
            }

            fetch('/api/search-single-vm', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ searchTerm })
            })
                .then(r => r.json())
                .then(data => {
                    hideError('singleVmError');
                    if (data.error) {
                        showError('singleVmError', data.error);
                        return;
                    }
                    displayResults('singleVm', data.results || [], data.count || 0);
                    currentResults['singleVm'] = data.results;
                })
                .catch(err => {
                    console.error('Error:', err);
                    showError('singleVmError', 'Failed to search VMs');
                });
        }

        function searchVCenter() {
            const vcenter = document.getElementById('vCenterSelect').value;
            if (!vcenter) {
                showError('vCenterError', 'Please select a vCenter');
                return;
            }

            const filters = {
                powerState: document.getElementById('filterPowerState').value,
                guestOs: document.getElementById('filterGuestOs').value,
                memoryGbMin: parseFloat(document.getElementById('filterMemoryMin').value) || null,
                memoryGbMax: parseFloat(document.getElementById('filterMemoryMax').value) || null,
                cpuCoresMin: parseInt(document.getElementById('filterCpuMin').value) || null,
                cpuCoresMax: parseInt(document.getElementById('filterCpuMax').value) || null,
                toolsStatus: document.getElementById('filterToolsStatus').value
            };

            fetch('/api/search-vcenter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ vcenter, filters })
            })
                .then(r => r.json())
                .then(data => {
                    hideError('vCenterError');
                    if (data.error) {
                        showError('vCenterError', data.error);
                        return;
                    }
                    displayResults('vCenter', data.results || [], data.count || 0);
                    currentResults['vCenter'] = data.results;
                })
                .catch(err => {
                    console.error('Error:', err);
                    showError('vCenterError', 'Failed to search vCenter');
                });
        }

        function searchMultipleVMs() {
            const searchTerms = document.getElementById('multipleVmSearch').value.trim();
            if (!searchTerms) {
                showError('multipleVmError', 'Please enter VM names');
                return;
            }

            fetch('/api/search-multiple-vms', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ searchTerms })
            })
                .then(r => r.json())
                .then(data => {
                    hideError('multipleVmError');
                    if (data.error) {
                        showError('multipleVmError', data.error);
                        return;
                    }
                    displayResults('multipleVm', data.results || [], data.count || 0);
                    currentResults['multipleVm'] = data.results;
                })
                .catch(err => {
                    console.error('Error:', err);
                    showError('multipleVmError', 'Failed to search VMs');
                });
        }

        function displayResults(type, results, count) {
            const tbody = document.getElementById(type + 'TableBody');
            const container = document.getElementById(type + 'Results');
            const countEl = document.getElementById(type + 'Count');

            tbody.innerHTML = '';
            countEl.textContent = count;

            if (count === 0) {
                tbody.innerHTML = '<tr><td colspan="12" style="text-align:center;padding:2rem;color:#94a3b8;">No VMs found</td></tr>';
            } else {
                results.forEach(vm => {
                    const row = document.createElement('tr');
                    const powerStateClass = vm.powerState === 'PoweredOn' ? 'status-powered-on' : 'status-powered-off';
                    row.innerHTML = `
                        <td>${vm.vmName || '-'}</td>
                        <td><span class="${powerStateClass}">${vm.powerState || '-'}</span></td>
                        <td>${vm.guestHostname || '-'}</td>
                        <td>${vm.vcenter || '-'}</td>
                        <td>${vm.numCpu || '-'}</td>
                        <td>${(vm.memoryGb || 0).toFixed(1)}</td>
                        <td>${(vm.provisionedGb || 0).toFixed(2)}</td>
                        <td>${(vm.usedGb || 0).toFixed(2)}</td>
                        <td>${vm.esxiHost || '-'}</td>
                        <td>${vm.cluster || '-'}</td>
                        <td>${vm.ipAddress || '-'}</td>
                        <td>${vm.toolsStatus || '-'}</td>
                    `;
                    tbody.appendChild(row);
                });
            }

            container.style.display = 'block';
            container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function exportResults(type) {
            const results = currentResults[type] || [];
            if (!results.length) {
                alert('No results to export');
                return;
            }

            fetch('/api/export-csv', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ searchResults: JSON.stringify(results) })
            })
                .then(r => r.blob())
                .then(blob => {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `vm-export-${new Date().toISOString().split('T')[0]}.csv`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                })
                .catch(err => console.error('Export failed:', err));
        }

        function clearFilters() {
            document.getElementById('filterPowerState').value = 'All';
            document.getElementById('filterGuestOs').value = 'All OSes';
            document.getElementById('filterMemoryMin').value = '';
            document.getElementById('filterMemoryMax').value = '';
            document.getElementById('filterCpuMin').value = '';
            document.getElementById('filterCpuMax').value = '';
            document.getElementById('filterToolsStatus').value = 'All Status';
        }

        function showError(elementId, message) {
            const el = document.getElementById(elementId);
            el.textContent = message;
            el.style.display = 'block';
        }

        function hideError(elementId) {
            document.getElementById(elementId).style.display = 'none';
        }
    </script>
</body>
</html>
